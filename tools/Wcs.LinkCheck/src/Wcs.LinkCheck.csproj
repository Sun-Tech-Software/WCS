<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the links of the repository's Markdown documents the way GitHub resolves them.
       No package: it must run in CI with nothing but the .NET SDK. Usage in Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wcs.LinkCheck</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
