<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only: no private feed is needed to build the WCS. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
