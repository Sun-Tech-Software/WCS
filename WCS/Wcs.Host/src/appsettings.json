{
  "Wcs": {
    "ApiKey": "cambiami-prima-di-installare",
    "ReadOnlyApiKey": "",
    "AllowInsecureRemoteHttp": false,
    // true serves a device with ConnectionType Connected whose connection was not built with the
    // loopback driver (the simulator), with a warning; false (the default) leaves it OffLine and
    // refuses Run while it lacks its connection. The host does not start with true in Production.
    "AllowSimulatorForMissingConnections": false,
    "DatabaseDirectory": "Data",
    // Quanti file mensili dello storico restano in linea, compreso quello corrente: all'avvio
    // l'host cancella i piu' vecchi.
    "HistoryMonthsToKeep": 12,
    "MaxRequestBodyMegabytes": 256,
    // The field driver: an IConnectionFactory as "Namespace.TypeName, AssemblyName", loaded from the
    // host folder. Absent: the default of this build (none in a build without a driver). "none" (or
    // ""): no field driver, only the loopback driver (devices with ConnectionType Test); devices with
    // ConnectionType Connected then stay without connection and go OffLine, and Run is refused. In an environment
    // variable write Wcs__ConnectionFactory=none: on Windows an empty variable does not exist.
    // "ConnectionFactory": "none",
    "StartEngine": true,
    "AutoRun": false,
    "Engine": {
      "DefaultRejectItem": "00000000-0000-0000-0000-000000000000",
      "MasterProcessOnEvery": 1000,
      "NumCurrentStoringStep": 0,
      "LockCellOnStoringError": false,
      "LimitOneShippingNotePerBuffer": false,
      "DiscardLuManagedInWarehouse": false,
      "DisableUnloadLu": false,
      "SwitchLuLengthVsLuWidth": false,
      "ActivateDebugLog": false
    }
  },
  "Wms": {
    // L'origine dell'API del gestionale (schema, nome e porta, senza percorso): e' il confine da
    // cui il motore prende il magazzino. Obbligatorio quando Wcs:StartEngine e' vero: senza,
    // l'host non parte. Il valore qui e' quello di sviluppo di WMS.Services.API, da cambiare in
    // installazione.
    "ApiAddress": "http://localhost:5142",
    // Segreto: NON metterlo qui, questo file e' tracciato da git. Va nella variabile d'ambiente
    // Wms__ApiKey (o in appsettings.Secrets.json non tracciato). E' la stessa chiave di
    // WcsWarehouse:ApiKey nell'appsettings di WMS.Services.API. Finche' e' questa di esempio o e'
    // vuota, l'host non parte.
    "ApiKey": "cambiami-prima-di-installare"
  },
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://127.0.0.1:5580" } } },
  // Microsoft.AspNetCore.SignalR.HubConnectionHandler a Debug: e' la sola categoria, e il solo
  // livello, a cui SignalR scrive PERCHE' ha chiuso una connessione - un messaggio dal browser oltre
  // il tetto del circuito, per esempio (coda dei lavori voce 13): sotto il Warning di
  // Microsoft.AspNetCore un circuito dell'Editor web che cade non lascerebbe traccia. Poche righe per
  // connessione. Due volte, e la seconda serve: su Windows il registro eventi riceve dal costruttore
  // predefinito un filtro nel codice a Warning, che solo una regola per EventLog e categoria supera
  // (si veda SignalRLoggingTest).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR.HubConnectionHandler": "Debug"
    },
    "EventLog": { "LogLevel": { "Microsoft.AspNetCore.SignalR.HubConnectionHandler": "Debug" } }
  }
}
