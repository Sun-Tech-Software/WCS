<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Il riscontro delle sagome copre DUE superfici (lotto delle sagome del proprietario):
         l'immagine di draw.io e il nodo della tela SVG. Il nodo lo rende bUnit, la stessa versione
         gia' usata da Wcs.WebEditor.Test - e questo e' l'unico progetto che vede insieme il registro
         del motore e chi disegna, quindi l'unico dove le due superfici possono cambiare sotto la
         stessa rete. -->
    <PackageReference Include="bunit" Version="2.11.3" />
    <!-- ConnectionFactoryLoaderTest compiles a driver and its dependency into a folder the runtime
         does not know, as a third-party driver dropped next to Wcs.Host.exe. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Il riscontro delle sette sagome, letto da DeviceShapeGoldenTest accanto all'assembly. -->
    <None Update="DeviceShapes.golden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wcs.Host.csproj" />
    <!-- Per FakeWarehouse: la controfigura di IWarehouse, come in Wcs.Engine.Test (compito 7). -->
    <ProjectReference Include="..\..\..\Wcs.Wms.Contracts\tests\Wcs.Wms.Contracts.Test\Wcs.Wms.Contracts.Test.csproj" />
  </ItemGroup>
</Project>
