<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- ATTENZIONE a chi lancia dotnet test sulla SOLUZIONE: questo progetto diventa rosso senza i
       browser di Playwright e senza WCS_HOST_EXE, e lo fa apposta - una prova che si salta da sola
       quando manca l'ambiente non fa piu' da rete e nessuno se ne accorge. Che cosa serve, e come si
       prepara una volta sola, sta nel README.md accanto a questo file. -->
  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Il motivo per cui questo progetto esiste: bUnit non esegue JavaScript, quindi le 746 prove
         di Wcs.WebEditor.Test non vedrebbero MAI un cambiamento di comportamento di draw.io. Qui il
         browser e' vero e draw.io gira davvero. Sta in un progetto SUO, e non fra quelle prove,
         perche' e' lento e pretende i browser scaricati (playwright install): una macchina senza
         quei browser non deve veder diventare rossa la suite normale. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- L'impianto di prova si semina con il client vero, non con richieste HTTP scritte a mano:
         se il contratto cambia, questo progetto smette di compilare invece di seminare un impianto
         che non e' piu' quello. Nessun riferimento a Wcs.Host: l'host si avvia come PROCESSO gia'
         costruito (si veda WcsHostProcess), non si ricostruisce da qui. -->
    <ProjectReference Include="..\..\..\Wcs.Api.Client\src\Wcs.Api.Client.csproj" />
  </ItemGroup>
</Project>
