<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Usato dal compito 2: Key.razor e' il primo componente interattivo, e bUnit lo collauda
         fuori da un browser vero. Versione 2.10.3, l'unico pacchetto "bunit" attuale (dalla 2.x
         sostituisce la coppia bunit.core/bunit.web). -->
    <PackageReference Include="bunit" Version="2.13.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wcs.WebEditor.csproj" />
  </ItemGroup>
</Project>
