@page "/editor/drawio"
@rendermode RenderMode.InteractiveServer
@implements IAsyncDisposable
@using System.Net
@using System.Net.Http
@using System.Xml
@using Microsoft.JSInterop
@using Wcs.Api.Client
@using Wcs.Api.Contracts.Dtos
@using Wcs.WebEditor.Checks
@using Wcs.WebEditor.Drawing
@using Wcs.WebEditor.Drawio
@using Wcs.WebEditor.Drawio.Components
@using Wcs.WebEditor.Drawio.Coordination
@using Wcs.WebEditor.Editing
@using Wcs.WebEditor.Io
@using Wcs.WebEditor.Live
@using Wcs.WebEditor.Properties
@using Wcs.WebEditor.Wms
@using static Wcs.Common.Enums
@inject EditorSessionState State
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<PlantLiveFeed> FeedLogger

@if (!State.HasKey)
{
    <Key OnKeyAccepted="OnKeyAcceptedAsync" />
}
else
{
    <div class="drawio-shell">
        <DrawioEditorStatus Creating="CreationReportState.Creating"
                            Selection="SelectionState"
                            SaveRound="_saveRound" />
        @* THE BAR (passata grafica, 2026-09-29, the owner's direction A): one line holds what used to be
           stacked above and below the strip of sections - in this order, the title, the engine, the
           live link, "Read only" while the engine runs or its state is not known (ReadOnlyReason), the
           plant checks, the Rulers switch, and after a separator the plant's file (rows 43-44, here
           since 27/9), Operations, the lists (compito 2, rows 58 and 59; compito 3, row 60) and the PLC
           connections (compito 4, row 62).
           It is still .drawio-sections: the checks and the six sections are ONE button each, and each
           opens in a floating window over the canvas (DrawioWindow, spec 2026-09-29), any number of
           them at a time (_openSections). The bar stays one line whatever is open - on a narrow window
           the buttons lose their words before it wraps - and a window takes no height from the
           drawing: measured, two strips of their own made draw.io's canvas short enough for its own
           windows to cover its Save button, and a section that opened INSIDE the strip shrank the
           drawing by its own height - the only reason for the old "one open at a time" rule. The
           windows are rendered inside the bar, as its direct children (drawio-windows.js finds its
           strip from them), but are position:fixed to the viewport, and nothing from here up to
           <body> is a containing block or a stacking context for them (no transform, filter, contain
           or z-index on .drawio-shell or .drawio-sections): keep it so, or their place and their order
           in front of each other go wrong. The row of outcomes under the bar holds the windows of its
           reports in the same way (DrawioNotices). No window ever goes above the top of .drawio-body,
           so none ever covers the bar or the lines under it (the engine's refusal, the row of
           outcomes), however much the bar grows or the row gets lines (the owner's decision of 29/9):
           drawio-windows.js watches the elements of this column for that.
           The title is a fixed "WCS Editor" (the owner's decision of 29/9): neither the host nor the
           API's contract has a name for the plant. *@
        <div class="drawio-sections">
            <span id="drawio-plant-name" class="drawio-plant-name">WCS Editor</span>
            <DrawioEngineSwitch Status="DisplayedNavStatus" State="_engine.State"
                                OnStart="() => _engine.StartAsync()" OnStop="() => _engine.StopAsync()" />
            <DrawioLiveStatus Connection="_live?.Connection" DrawFailed="_liveDrawFailed" DrawFailedReason="@_liveDrawReason" Unavailable="@_liveUnavailable"
                              Trouble="@((_hoverFailure ?? _liveFailure)?.Text)" TroubleDetail="@((_hoverFailure ?? _liveFailure)?.Detail)" />
            @* The orange banner of the engine until 29/9, in the same two cases (a running engine, a
               status not known) and with the same sentences, now behind the pill's tip - and the pill's
               description for a screen reader (aria-describedby): hidden, the tip is out of the
               accessibility tree, and the pill would say "Read only" and never why. *@
            @if (_graph is not null && ReadOnlyReason is { } readOnly)
            {
                <span id="drawio-engine-banner" class="drawio-pill drawio-pill-warn drawio-has-tip" tabindex="0" aria-describedby="drawio-engine-banner-tip"><DrawioIcon Name="lock" />Read only<span id="drawio-engine-banner-tip" class="drawio-tip" role="tooltip">@readOnly</span></span>
            }
            <DrawioToolbar Graph="_graph"
                           ChecksSummary="@ChecksSummaryLine"
                           Open="IsOpen(DrawioSection.Checks)" OnToggle="() => PressSectionButtonAsync(DrawioSection.Checks)" OnClose="() => CloseSectionAsync(DrawioSection.Checks)" Place="WindowPlaces[DrawioSection.Checks]"
                           CheckTargets="CheckTargets"
                           GoToOutcome="@_goToOutcome"
                           GoToReached="_goToReached"
                           OnCheckedIsolatedDevices="OnCheckedIsolatedDevices"
                           OnRunningChanged="OnConfigCheckRunningChanged"
                           OnGoToDevice="GoToDeviceAsync" />
            <DrawioRulerSwitch Enabled="_rulersOn" OnToggle="OnRulerToggleAsync" />
            <span class="drawio-bar-separator" aria-hidden="true"></span>
            <DrawioPlantFile Open="IsOpen(DrawioSection.PlantFile)" OnToggle="() => PressSectionButtonAsync(DrawioSection.PlantFile)" OnClose="() => CloseSectionAsync(DrawioSection.PlantFile)" Place="WindowPlaces[DrawioSection.PlantFile]"
                             Graph="_graph" EngineStatus="DisplayedNavStatus" WriteThroughThePage="ImportThroughTheGateAsync" />
            <DrawioOperations Open="IsOpen(DrawioSection.Operations)" OnToggle="() => PressSectionButtonAsync(DrawioSection.Operations)" OnClose="() => CloseSectionAsync(DrawioSection.Operations)" Place="WindowPlaces[DrawioSection.Operations]"
                              Graph="_graph" Feed="_live" NavigatorStatus="DisplayedNavStatus"
                              SelectedItemId="SelectionState.ConfigItemId" SelectedItemName="@SelectionState.ConfigSubjectName"
                              WriteThroughThePage="ModeThroughTheGateAsync" OnModeWritten="ReloadPlantItemsAsync" />
            <DrawioDeviceList Open="IsOpen(DrawioSection.Devices)" OnToggle="() => PressSectionButtonAsync(DrawioSection.Devices)" OnClose="() => CloseSectionAsync(DrawioSection.Devices)" Place="WindowPlaces[DrawioSection.Devices]"
                              Graph="_graph" Feed="_live" SelectedItemId="SelectionState.ConfigItemId"
                              GoToOutcome="@_deviceListGoTo?.Outcome" OnSelect="GoToFromDeviceListAsync"
                              Write="WriteFromDeviceListAsync" />
            <DrawioJunctionList Open="IsOpen(DrawioSection.Junctions)" OnToggle="() => PressSectionButtonAsync(DrawioSection.Junctions)" OnClose="() => CloseSectionAsync(DrawioSection.Junctions)" Place="WindowPlaces[DrawioSection.Junctions]"
                                Graph="_graph" SelectedJunctionId="SelectedJunctionId"
                                GoToOutcome="@_junctionListGoTo?.Outcome" OnSelect="GoToJunctionAsync" />
            <DrawioMissionList Open="IsOpen(DrawioSection.Missions)" OnToggle="() => PressSectionButtonAsync(DrawioSection.Missions)" OnClose="() => CloseSectionAsync(DrawioSection.Missions)" Place="WindowPlaces[DrawioSection.Missions]"
                               Graph="_graph" Feed="_live" SelectedItemId="SelectionState.ConfigItemId"
                               SelectedItemName="@SelectionState.ConfigSubjectName"
                               GoToOutcome="@_missionListGoTo?.Outcome" OnSelect="GoToFromMissionListAsync" />
            <DrawioPlcConnections Open="IsOpen(DrawioSection.PlcConnections)" OnToggle="() => PressSectionButtonAsync(DrawioSection.PlcConnections)" OnClose="() => CloseSectionAsync(DrawioSection.PlcConnections)" Place="WindowPlaces[DrawioSection.PlcConnections]"
                                  Graph="_graph" WriteThroughThePage="PlcConnectionsThroughTheGateAsync" />
            @if (SelectionState.ConfigItemId is { } contextualItemId)
            {
                @* These two windows have no permanent toolbar button: they belong to the device's
                   context menu and close when that device stops being the sole selection. They still
                   use DrawioWindow, so moving, resizing, Esc and stacking behave like every other
                   window of the Editor. *@
                <DrawioWindow @key="@($"mission-steps-{contextualItemId}")"
                              Id="drawio-mission-steps-window" Class="drawio-context-window drawio-mission-steps-window"
                              Title="@($"Mission steps: {SelectionState.ConfigSubjectName}")" Icon="missions"
                              Open="@(_missionStepsWindowItemId == contextualItemId)" OnClose="CloseMissionStepsWindow"
                              Place="MissionStepsWindowPlace">
                    <Help>
                        <p>The steps of the active missions that touch this device — running on it, leaving from it or arriving at it — as the host has them. Read-only.</p>
                    </Help>
                    <ChildContent>
                        <DrawioMissionSteps ItemId="contextualItemId" Items="_graph?.Items ?? []" Feed="_live" />
                    </ChildContent>
                </DrawioWindow>
                <DrawioWindow @key="@($"linked-storage-cells-{contextualItemId}")"
                              Id="drawio-linked-storage-cells-window" Class="drawio-context-window drawio-linked-storage-cells-window"
                              Title="@($"Linked storage cells: {SelectionState.ConfigSubjectName}")" Icon="linked-cells"
                              Open="@(_linkedCellsWindowItemId == contextualItemId)" OnClose="CloseLinkedCellsWindow"
                              Place="LinkedCellsWindowPlace">
                    <Help>
                        <p>The warehouse cells connected to this device. Linking and unlinking use the same edit rules as the device configuration.</p>
                    </Help>
                    <ChildContent>
                        <DrawioLinkedStorageCells ItemId="contextualItemId" State="SelectionState"
                                                  OnSaveDoorMappings="SaveDoorMappingsAsync"
                                                  OnClearDoorMappings="ClearDoorMappingsAsync"
                                                  OnLinkCell="LinkCellAsync" OnUnlinkCell="UnlinkCellAsync" />
                    </ChildContent>
                </DrawioWindow>
            }
        </div>
        @* The engine's refusal, whole, on a line of its own right under the bar and its engine. Most
           refusals say what counts at their end ("... so the engine was NOT started. Save first, then
           start it."): cut short on the bar's one line, with the rest behind a tip, that part was off
           the screen (review of 29/9; the owner's decision 2 of the spec: a rule that blocks is seen
           next to the command, as the refusal always was). It stays until the engine's next gesture,
           as it always has - and it is not in the row of outcomes below, which the spec gives to the
           outcomes of the drawing (the reports, a refused cut, the drawing out of reach): a band of
           its own in the danger's tint, as tall as a line of that row. *@
        @if (_engine.State.Error is { } engineRefusal)
        {
            <DrawioFailureLine Id="drawio-engine-error" LineClass="drawio-engine-error" Text="@engineRefusal" Detail="@_engine.State.ErrorDetail" />
        }
        @* Until the plant is there, a quiet line under the bar says so - not when the drawing is out of
           reach: that is said in the row, and the plant would never come. *@
        @if (!_bridgeUnavailable && _graph is null)
        {
            <p class="editor-loading">Loading the plant...</p>
        }
        <DrawioNotices Notices="Notices" />
        <div class="drawio-body">

            <iframe id="drawio-frame" @ref="_iframeElement" title="Plant drawing"></iframe>

            <DrawioPropertyDock State="SelectionState"
                                Items="_graph?.Items ?? []"
                                LoadUnit="@SelectedLoadUnit"
                                Commands="DeviceCommands"
                                Duplicate="DuplicateAction"
                                DuplicateReport="_duplication.Report"
                                MenuNotice="@_menuNotice?.Text"
                                MenuNoticeDetail="@_menuNotice?.Detail"
                                OnSaveConfig="SaveSelectedConfigAsync"
                                OnReassociateTypedChanged="value => _selection.SetReassociateTyped(value)"
                                OnReassociate="ReassociateAsync" />
        </div>
        @* Row 35: the pointer's position in PLANT units. Written directly by drawio-bridge.js on
           every mouse move over the canvas (watchPointer/unwatchPointer) - never through Blazor,
           which this element's markup never binds any content to, so nothing here ever overwrites
           what the bridge just wrote. Empty here and empty again whenever the pointer is not on the
           canvas: the bridge owns making it appear, this page only reserves the stable id. *@
        <div class="drawio-status-bar">
            <span id="drawio-pointer-position" class="drawio-pointer-position"></span>
        </div>
    </div>
}

@code {
    private const string FrameUrl =
        "_content/Wcs.WebEditor/drawio/index.html" +
        "?embed=1&proto=json&spin=1&libraries=0&noSaveBtn=1&noExitBtn=1&lang=en&ui=min&configure=1" +
        "&libs=" + DrawioLibrary.SectionId + "%3Bgeneral%3Buml%3Ber%3Bbpmn%3Bflowchart%3Bbasic%3Barrows2";

    private const string BridgeModulePath = "./_content/Wcs.WebEditor/drawio-bridge.js";

    private const string LiveModulePath = "./_content/Wcs.WebEditor/drawio-live.js";

    private const string BridgeNotLoadedMessage =
        "The bridge to draw.io did not load: the plant cannot be shown. Reload the page.";

    private const string BridgeNotRespondingMessage =
        "The bridge to draw.io loaded but did not answer: the plant cannot be shown. Reload the page.";

    private const string BridgeTimedOutMessage =
        "The bridge to draw.io did not answer in time: the plant cannot be shown. Reload the page.";

    private const string DocumentNotSentMessage =
        "The plant drawing never reached draw.io: the canvas you see is NOT the plant, and a save from here will write nothing. Reload the page.";

    private const string LibraryNotSentMessage =
        "The configuration never reached draw.io: the drawing cannot start. Reload the page.";

    private PlantGraph? _graph;

    private string? _decorationXml;

    private bool _decorationLoaded;

    /// <summary>Why the decoration could not be read at opening: the save's refusal says it, with what came back behind its "?".</summary>
    private Exception? _decorationFailure;

    private DrawioSaid? _decorationNotice;

    private readonly Dictionary<string, Guid> _plantJunctionByDrawnEdge = [];

    private readonly Dictionary<string, Guid> _plantItemByDrawnCell = [];

    private EditLockDto? _lockDenied;

    private NavigatorStatusTypes? _navStatus;

    private bool _lockEverGranted;

    /// <summary>
    /// The page writes with the permit held and the engine stopped or paused - not in Run, and since
    /// the owner's decision of 27/9 (D2) not in Recover (the plant being loaded) or Dispose either, as
    /// the host refuses them (PlantQueries.RequireNotRunning).
    /// </summary>
    private bool CanEdit => _lockDenied is null && _navStatus is NavigatorStatusTypes.Stop or NavigatorStatusTypes.Pause;

    /// <summary>
    /// The engine's status as the page SHOWS it (the banner): the last known one, from
    /// whichever of the two sources spoke last - the live feed, or this page's own GET /status.
    /// <see cref="_navStatus"/> stays the page's own read, the one the write decision is taken on
    /// (<see cref="EnsureWritableAsync"/>). See <see cref="ShowNavStatusAsync"/> for which read
    /// counts as newer.
    /// </summary>
    private NavigatorStatusTypes? DisplayedNavStatus => _shownNavStatus;

    private NavigatorStatusTypes? _shownNavStatus;

    /// <summary>Bumped at every status the page shows: a GET that started before the last bump is older than what is shown.</summary>
    private long _navSequence;

    private DrawioCreationCoordinator _creation = null!;
    private DrawioSelectionCoordinator _selection = null!;
    private DrawioGeometryCoordinator _geometry = null!;
    private DrawioSaveCoordinator _save = null!;
    private DrawioEngineCoordinator _engine = null!;

    private DrawioCreationReportState CreationReportState => _creation.State;

    private DrawioSaveReportState SaveReportState => _save.State;
    private long _saveRound => _save.Round;

    /// <summary>
    /// The row of outcomes under the bar (passata grafica, 2026-09-29; DrawioNotices says how it shows
    /// them): everything this page has to say about the drawing, and the one trouble of the live link
    /// that asks the operator to act, one line each, in this order of precedence for the ones that
    /// arrive together - the drawing out of reach, the live channel that could not be built, the
    /// decoration that could not be read, the devices the drawing does not show, the drops that can no
    /// longer become devices, the last drop's report, the cells of a gesture too many to follow (queue
    /// item 15), a save lost in a drop of the circuit's connection and the drop itself (queue item 14),
    /// the last save's, a refused cut. Until then each was a band of its own above the bar
    /// (DrawioEditorStatus, the live link) or under it (the cut).
    /// </summary>
    private IReadOnlyList<DrawioNoticeLine> Notices
    {
        get
        {
            List<DrawioNoticeLine> notices = [];
            if (_bridgeUnavailable)
                notices.Add(new DrawioNoticeLine("drawio-bridge", DrawioNoticeTone.Bad, _bridgeUnavailableMessage, Dismissable: false, null)
                {
                    LineClass = "drawio-bridge-error",
                });
            if (DrawioLiveStatus.UnavailableNoticeOf(_liveUnavailable) is { } liveOff) notices.Add(liveOff);
            // The decoration's warning whole, as the drawing out of reach is: its last sentence -
            // reload now, before drawing - is the only one that says what to do, and a line cut
            // before it would leave that behind "Details". The sentence keeps its id.
            if (_decorationNotice is { } decoration)
                notices.Add(new DrawioNoticeLine("drawio-decoration", DrawioNoticeTone.Warn, decoration.Text, Dismissable: false, null)
                {
                    LineId = "drawio-decoration-banner",
                    LineDetail = decoration.Detail,
                });
            if (DrawioUndrawnReport.NoticeOf(_graph) is { } undrawn) notices.Add(undrawn);
            if (DrawioCreationReport.UnavailableNoticeOf(CreationReportState) is { } deaf) notices.Add(deaf);
            if (DrawioCreationReport.NoticeOf(CreationReportState, _creation.Report) is { } creation) notices.Add(creation);
            // Queue item 15: the cells a gesture brought that this page could not be told of.
            if (_tooManyCellsAdded is { } tooMany)
                notices.Add(new DrawioNoticeLine("drawio-too-many-added", DrawioNoticeTone.Warn, tooMany, Dismissable: true, null)
                {
                    LineRole = "status",
                    Occurrence = _tooManyCellsAddedTimes,
                });
            // Queue item 14: what a drop of the circuit's connection may have taken - the save first,
            // when one was lost in it or may have been written across it (task 12), then the line every
            // drop gets.
            if (_saveLostInADrop)
                notices.Add(new DrawioNoticeLine("drawio-save-lost", DrawioNoticeTone.Bad, SaveLostInADropMessage, Dismissable: true, null)
                {
                    LineRole = "status",
                    Occurrence = _savesLostInADrop,
                });
            if (_saveMayHaveBeenWritten)
                notices.Add(new DrawioNoticeLine("drawio-save-unknown", DrawioNoticeTone.Warn, SaveMayHaveBeenWrittenMessage, Dismissable: true, null)
                {
                    LineRole = "status",
                    Occurrence = _savesMayHaveBeenWritten,
                });
            if (_connectionDrops > 0)
                notices.Add(new DrawioNoticeLine("drawio-reconnected", DrawioNoticeTone.Warn, ConnectionCameBackMessage, Dismissable: true, null)
                {
                    LineRole = "status",
                    Occurrence = _connectionDrops,
                });
            if (DrawioSaveReport.NoticeOf(SaveReportState, _saveRound) is { } save) notices.Add(save);
            if (_cutRefused is { } cutRefused)
                notices.Add(new DrawioNoticeLine("drawio-cut", DrawioNoticeTone.Bad, cutRefused, Dismissable: true, null)
                {
                    LineId = "drawio-cut-refused",
                    LineRole = "status",
                    Occurrence = _cutRefusals,
                });
            return notices;
        }
    }

    private ElementReference _iframeElement;
    private IJSObjectReference? _bridgeModule;
    private DotNetObjectReference<DrawioEditor>? _bridgeCallbackRef;
    private bool _bridgeAttachAttempted;

    /// <summary>
    /// Attach went through. Until then nothing else may be called on the bridge module - not even
    /// from a render that lands while the attach is still being awaited, which OnAfterRenderAsync
    /// would otherwise let through (<c>AttachIsTheFirstCallEverMadeOnTheBridgeModule</c>).
    /// </summary>
    private bool _bridgeAttached;
    private bool _bridgeUnavailable;
    private string _bridgeUnavailableMessage = "";

    private bool _drawioReady;

    private bool _documentSent;

    /// <summary>
    /// Row 33: what the ruler switch shows and what is applied to draw.io once it is ready. Read
    /// from the browser's memory right after <c>attach</c> (<see cref="LoadRulerPreferenceAsync"/>,
    /// called from the same method that awaits <c>attach</c> - fix round 2 moved this read from
    /// before attach to after it, see the comment there), independent of draw.io itself - the switch
    /// must show the remembered choice even before the canvas exists. Default false (rulers off),
    /// same as the parity inventory's own default and the same value a bUnit render gets from a loose
    /// "loadRulerPreference" that nobody configured.
    /// </summary>
    private bool _rulersOn;

    private bool _librarySent;

    private DrawioSelectionState SelectionState => _selection.State;

    /// <summary>
    /// The selected device, its live status and the load unit it holds as of the last render triggered
    /// from <see cref="RefreshLiveAsync"/>: a frame that leaves all three the same does not deserve a
    /// render. The load unit since the passata grafica: the panel's heading shows it.
    /// </summary>
    private (Guid ItemId, DeviceStatusTypes? Status, string? LoadUnit)? _lastRenderedDeviceStatus;

    /// <summary>
    /// The load unit the selected device holds as the live channel says it - in the words of the device
    /// list's "Load unit" column - for the heading of the properties panel; null when it holds none.
    /// </summary>
    private string? SelectedLoadUnit =>
        SelectionState.ConfigItemId is { } itemId && _live?.StatusOf(itemId) is { } status
            ? PlantLiveState.ViewOf(status).LoadUnit
            : null;

    /// <summary>
    /// The commands of the selected device: only with the engine running, as in the WinForms (row 54).
    /// Gated on <see cref="DisplayedNavStatus"/>, the status the page SHOWS - not <see cref="_navStatus"/>,
    /// which is this page's own GET used only for the write decision (<see cref="EnsureWritableAsync"/>).
    /// </summary>
    private RenderFragment? DeviceCommands =>
        DisplayedNavStatus == NavigatorStatusTypes.Run && SelectionState.ConfigItemId is { } itemId
            ? builder =>
            {
                builder.OpenComponent<DrawioDeviceCommands>(0);
                // Keyed on the device: another selection is another component, and the outcome of the
                // last command does not carry over to a device it was not sent to.
                builder.SetKey(itemId);
                builder.AddComponentParameter(1, nameof(DrawioDeviceCommands.ItemId), itemId);
                builder.AddComponentParameter(2, nameof(DrawioDeviceCommands.DeviceName), SelectionState.ConfigSubjectName);
                builder.AddComponentParameter(3, nameof(DrawioDeviceCommands.Status), _live?.StatusOf(itemId)?.Status);
                builder.AddComponentParameter(4, nameof(DrawioDeviceCommands.Feed), _live);
                // Row 63: a command chosen from draw.io's right-click menu, sent by THIS component
                // as its own button would send it - see OnDrawioMenuEntry.
                builder.AddComponentParameter(5, nameof(DrawioDeviceCommands.MenuRequest), _menuCommand);
                builder.CloseComponent();
            }
            : null;

    /// <summary>
    /// Row 63 (compito 5 fix round 2): the panel's "Duplicate device" for the selected device - the
    /// button, and the question with its two answers once it is asked (<see cref="_duplicateQuestion"/>).
    /// Keyed on the device like the commands: another selection is another question.
    /// </summary>
    private RenderFragment? DuplicateAction =>
        SelectionState.ConfigItemId is { } itemId
            ? builder =>
            {
                builder.OpenComponent<DrawioDuplicateDevice>(0);
                builder.SetKey(itemId);
                builder.AddComponentParameter(1, nameof(DrawioDuplicateDevice.SourceName), SelectionState.ConfigSubjectName);
                // The name the question OFFERED, kept from the moment it was asked: the one the write uses.
                builder.AddComponentParameter(2, nameof(DrawioDuplicateDevice.NewName), _duplicateQuestion is { } asked && asked.ItemId == itemId
                    ? asked.Name : _duplication.NameForTheDuplicateOf(itemId));
                builder.AddComponentParameter(3, nameof(DrawioDuplicateDevice.Armed), _duplicateQuestion?.ItemId == itemId);
                builder.AddComponentParameter(4, nameof(DrawioDuplicateDevice.Busy), _duplication.Duplicating);
                builder.AddComponentParameter(5, nameof(DrawioDuplicateDevice.OnAsk), EventCallback.Factory.Create(this, () => AskToDuplicate(itemId)));
                builder.AddComponentParameter(6, nameof(DrawioDuplicateDevice.OnConfirm), EventCallback.Factory.Create(this, () => DuplicateAsync(itemId)));
                builder.AddComponentParameter(7, nameof(DrawioDuplicateDevice.OnCancel), EventCallback.Factory.Create(this, () => _duplicateQuestion = null));
                builder.AddComponentParameter(8, nameof(DrawioDuplicateDevice.NotNow), DuplicateNotNow);
                builder.CloseComponent();
            }
            : null;

    /// <summary>
    /// The duplication question on screen, if any - the first of the two steps, asked by the panel's
    /// button or by the right-click menu's entry: the device, and the name it offered for the new one
    /// (fix round 3: carried to the write, not computed again there).
    /// </summary>
    private (Guid ItemId, string? Name)? _duplicateQuestion;

    private DrawioDuplicationCoordinator _duplication = null!;

    private void AskToDuplicate(Guid itemId) => _duplicateQuestion = (itemId, _duplication.NameForTheDuplicateOf(itemId));

    /// <summary>The second step: the answer. The question goes whatever the outcome - the report at the foot of the dock says it.</summary>
    private async Task DuplicateAsync(Guid itemId)
    {
        if (_duplicateQuestion is not { } asked || asked.ItemId != itemId) return;
        _duplicateQuestion = null;
        await _duplication.DuplicateAsync(itemId, asked.Name);
    }

    /// <summary>
    /// Draws the device the duplication has just created, with the very cell the next opening would
    /// draw for it (<see cref="DrawioDocument.DeviceCellXml"/>), selects it and brings it into view in
    /// the part of the canvas the page's windows leave free, as "go to" does (drawio-bridge.js,
    /// drawDeviceCell, queue item 24): drawn and selected, drawn only, not drawn, or not known - see
    /// DrawioDrawState. Not brought into view is still "drawn and selected": the bridge says so only to
    /// the browser console.
    /// </summary>
    private async Task<DrawioDrawOutcome> DrawTheDuplicateAsync(PlantItemDto item)
    {
        if (_bridgeModule is null || !_bridgeAttached) return new(DrawioDrawState.NotDrawn, "the bridge to draw.io is not attached");
        if (_graph is not { } graph || !graph.TypesByDeviceType.TryGetValue(item.DeviceType, out var type))
            return new(DrawioDrawState.NotDrawn, "its type is not in the registry this page holds");

        string? answer;
        try
        {
            answer = await _bridgeModule.InvokeAsync<string?>("drawDeviceCell", DrawioDocument.DeviceCellXml(type, item), item.ItemId.ToString());
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // The answer is lost, not the cell: draw.io may have added it before the interop gave up
            // (fix round 4). The drawing is asked whether a cell with that identifier is there now.
            return await WasTheDuplicateDrawnAsync(item.ItemId, DrawioFailureWords.Detail(ex));
        }

        return answer switch
        {
            "ok" => new(DrawioDrawState.Drawn),
            "ok-not-selected" => new(DrawioDrawState.DrawnNotSelected, "draw.io could not select it - the browser console says why"),
            "exists" => new(DrawioDrawState.DrawnNotSelected, "a cell with its identifier was already on the drawing"),
            "no-graph" => new(DrawioDrawState.NotDrawn, "this page cannot reach the drawing's model"),
            "failed" => new(DrawioDrawState.NotDrawn, "draw.io refused the cell - the browser console says why"),
            _ => new(DrawioDrawState.NotDrawn, $"the drawing answered {answer ?? "nothing at all"}"),
        };
    }

    /// <summary>After an answer that never came: is the duplicate's cell on the drawing? Asked with the bridge's markedCells, the same read the reassociation rests on.</summary>
    /// <remarks>Row 37 of the queue: how the answer was lost is behind the report line's "?", not in its words.</remarks>
    private async Task<DrawioDrawOutcome> WasTheDuplicateDrawnAsync(Guid itemId, string lostAnswer)
    {
        if (await ReadMarkedCellsAsync() is not { } marked)
            return new(DrawioDrawState.Unknown, "its answer was lost, and the drawing could not be asked afterwards", lostAnswer);
        return marked.Any(cell => cell.Id == itemId.ToString())
            ? new(DrawioDrawState.DrawnNotSelected, "the page did not hear draw.io's answer, but the cell is on the drawing", lostAnswer)
            : new(DrawioDrawState.NotDrawn, "its answer was lost, and the drawing holds no cell for it", lostAnswer);
    }

    /// <summary>
    /// Where a device's cell is drawn NOW (drawio-bridge.js, cellBox) - the duplicate goes next to it,
    /// as the WinForms put it next to the live node. The reason instead when the drawing cannot say.
    /// </summary>
    private async Task<(DrawioCellBox? Box, string? Why, string? Detail)> SourceOnTheCanvasAsync(Guid itemId)
    {
        if (_bridgeModule is null || !_bridgeAttached) return (null, "the bridge to draw.io is not attached", null);
        DrawioCellBoxAnswer? answer;
        try
        {
            answer = await _bridgeModule.InvokeAsync<DrawioCellBoxAnswer?>("cellBox", DrawnCellOf(itemId));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Row 37 of the queue: what the interop said is behind the report line's "?". Final review,
            // M8: the why is the failure's own - a script that threw did answer, with an error.
            return (null, DrawioFailureWords.WhyTheScriptDidNotAnswer(ex), DrawioFailureWords.Detail(ex));
        }

        return answer?.Answer switch
        {
            "ok" => (new DrawioCellBox(answer.X, answer.Y, answer.Width, answer.Height, answer.Rotation), null, null),
            "no-cell" => (null, "it has no cell on the drawing", null),
            "grouped" => (null, "its cell is inside a group, where the drawing's position is relative to the group", null),
            "no-graph" => (null, "this page cannot reach the drawing's model", null),
            "failed" => (null, "draw.io could not read its cell - the browser console says why", null),
            _ => (null, $"the drawing answered {answer?.Answer ?? "nothing at all"}", null),
        };
    }

    /// <summary>The bridge's answer to cellBox, as it comes over the interop.</summary>
    internal sealed record DrawioCellBoxAnswer(string Answer, double X, double Y, double Width, double Height, double Rotation);

