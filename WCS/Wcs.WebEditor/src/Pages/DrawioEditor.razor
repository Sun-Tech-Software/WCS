        ForgetTheMenuEntryTheSelectionMadeUntrue(null);
        return _selection.SelectionTooLargeToFollowAsync(count);
    }

    [JSInvokable]
    public Task OnDrawioCellsAdded(DrawioAddedCell[]? cells) =>
        _creation.CellsAddedAsync(cells ?? []);

    /// <summary>
    /// Queue item 15: a gesture brought <paramref name="count"/> cells into the drawing, too many to
    /// describe to the page in one message of the circuit (drawio-bridge.js, tellOrWarn): the bridge
    /// sent their count instead, and none of them can become a device. Said in the row under the bar.
    /// </summary>
    [JSInvokable]
    public void OnDrawioTooManyCellsAdded(int count)
    {
        _tooManyCellsAdded = $"Too many cells to follow ({count}): the cells just added are not known to this page, and none of them became a device.";
        _tooManyCellsAddedTimes++;
        TryStateHasChanged();
    }

    /// <summary>The line of <see cref="OnDrawioTooManyCellsAdded"/>, null when there is nothing to say.</summary>
    private string? _tooManyCellsAdded;

    /// <summary>How many gestures brought too many cells: each one is a new outcome in the row, as a refused cut is.</summary>
    private long _tooManyCellsAddedTimes;

    [JSInvokable]
    public void OnDrawioCreationUnavailable() => _creation.MarkUnavailable();

    /// <summary>
    /// Row 63 (compito 5): an entry of ours chosen in draw.io's right-click menu on a device
    /// (drawio-bridge.js, hookThePopupMenu). Every entry is an action the properties panel already
    /// has, and it is done THROUGH the panel: the bridge has already made the device the only cell
    /// selected, so the panel is about it, and the entry either brings a part of that panel into view
    /// (<see cref="RevealWhenThePanelIsReadyAsync"/>) or hands the command to the panel's own commands
    /// component (<see cref="DrawioMenuCommand"/>), which sends it as its button would. Nothing here
    /// touches draw.io's model or the drawing.
    /// </summary>
    /// <remarks>
    /// What the page refuses, it says (<c>#drawio-menu-notice</c>), and it never does something else
    /// instead: a cell it does not know as a device, an entry it does not know, a device the panel is
    /// not showing (the selection the menu made did not reach the page), a command with the engine
    /// not running - the same rule the panel's commands follow (<see cref="DeviceCommands"/>).
    /// </remarks>
    [JSInvokable]
    public async Task OnDrawioMenuEntry(string? cellId, string? entry)
    {
        _menuNotice = null;
        _menuReveal = null;
        _menuCommand = null;

        if (cellId is null || _selection.DeviceOf(cellId) is not { } device)
        {
            _menuNotice = $"The menu entry was about a shape that is not a device of the plant (cell {cellId ?? "(none)"}): nothing was done.";
            StateHasChanged();
            return;
        }

        var name = NameOf(device);
        if (DrawioContextMenu.Parse(entry) is not { } chosen)
        {
            _menuNotice = $"The menu entry \"{entry}\" is not one this page knows: nothing was done to {name}.";
        }
        else if (DrawioContextMenu.CommandOf(chosen) is { } command)
        {
            var label = DrawioContextMenu.Of(command).Label;
            if (DisplayedNavStatus != NavigatorStatusTypes.Run)
                _menuNotice = $"{label} was NOT sent to {name}: the engine is not running, and the device commands are offered only while it runs.";
            else if (SelectionState.ConfigItemId != device.ItemId)
                _menuNotice = $"{label} was NOT sent to {name}: the properties panel is not showing it (the selection did not reach this page). Select it and use the panel's own button.";
            else
                _menuCommand = new DrawioMenuCommand(device.ItemId, command);
        }
        else if (SelectionState.ConfigItemId != device.ItemId)
        {
            _menuNotice = $"{DrawioContextMenu.WhatOf(chosen)} of {name} could not be shown: the properties panel is not showing it (the selection did not reach this page). Select it on the drawing.";
        }
        else if (chosen is DrawioMenuEntry.MissionSteps or DrawioMenuEntry.LinkedStorageCells)
        {
            var alreadyOpen = chosen == DrawioMenuEntry.MissionSteps
                ? _missionStepsWindowItemId == device.ItemId
                : _linkedCellsWindowItemId == device.ItemId;
            if (chosen == DrawioMenuEntry.MissionSteps) _missionStepsWindowItemId = device.ItemId;
            else _linkedCellsWindowItemId = device.ItemId;

            if (alreadyOpen && _windowsModule is not null)
            {
                try
                {
                    await _windowsModule.InvokeAsync<bool>("activate",
                        chosen == DrawioMenuEntry.MissionSteps ? "drawio-mission-steps-window" : "drawio-linked-storage-cells-window");
                }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
                {
                    // It is already open; only bringing it above another window and focusing it was lost.
                }
            }
        }
        else
        {
            // "Duplicate Device" asks the panel's own question (the first of its two steps); the
            // answer stays the operator's, in the panel.
            if (chosen == DrawioMenuEntry.DuplicateDevice) AskToDuplicate(device.ItemId);
            _menuReveal = new DrawioMenuReveal(device.ItemId, DrawioContextMenu.TargetsOf(chosen)!, DrawioContextMenu.WhatOf(chosen), name);
        }

        StateHasChanged();
    }

    /// <summary>A part of the properties panel an entry of the right-click menu asked to bring into view, once the panel has it.</summary>
    private sealed record DrawioMenuReveal(Guid ItemId, string[] Targets, string What, string Name);

    private DrawioMenuReveal? _menuReveal;

    /// <summary>The device command chosen from the right-click menu, until the panel's commands component takes it or something makes it untrue.</summary>
    private DrawioMenuCommand? _menuCommand;

    /// <summary>What the page refused of a right-click menu entry, or could not do: said in the properties dock until the next entry or selection.</summary>
    private DrawioSaid? _menuNotice;

    /// <summary>
    /// Whether the properties panel shows everything it will show for <paramref name="itemId"/>: its
    /// configuration read (or its failure said), and the warehouse cells too for a device that has
    /// them - the same conditions the dock's own markup renders its sections on. Before that, the
    /// part the menu asked for may not be there yet, or may be pushed down by what arrives above it.
    /// </summary>
    private bool ThePanelIsSettledFor(Guid itemId)
    {
        var state = SelectionState;
        if (state.ConfigItemId != itemId) return false;
        if (state.ConfigError is not null) return true;
        if (state.Config is null) return false;
        return state.CellsKind == CellPanelKind.None
               || state.CellsError is not null
               || (state.WmsCells is not null && state.CellsMappings is not null);
    }

    /// <summary>
    /// Brings the part of the panel a menu entry asked for into view, once the panel is settled for
    /// that device: opened if it is a box, scrolled to, focused (drawio-bridge.js, revealInPanel). A
    /// panel that could not be reached is said, not kept quiet about. It goes through the bridge, so
    /// it waits for attach like every other call (<see cref="_bridgeAttached"/>): the entry stays
    /// pending until then, and the renders that attach itself makes bring it into view.
    /// </summary>
    private async Task RevealWhenThePanelIsReadyAsync()
    {
        if (_menuReveal is not { } reveal || !_bridgeAttached || _bridgeModule is not { } bridge
            || !ThePanelIsSettledFor(reveal.ItemId)) return;
        _menuReveal = null;

        string? answer = null;
        Exception? failure = null;
        try
        {
            answer = await bridge.InvokeAsync<string?>("revealInPanel", (object)reveal.Targets);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            failure = ex;
        }

        if (answer is not null && reveal.Targets.Contains(answer)) return;
        // Row 37 of the queue: a failure of the page's script is said in words, and what it threw is
        // behind the line's "?"; an answer the script did give is the page's own, and stays in the line.
        // Final review, M7: the why is the failure's own - "the script failed" was false for a call
        // that ran out of time, or for the connection to the browser lost.
        _menuNotice = failure is not null
            ? DrawioSaid.Failed($"{reveal.What} of {reveal.Name} could not be brought into view because {DrawioFailureWords.WhyTheScriptDidNotAnswer(failure)}: they are in the column on the right.", failure)
            : $"{reveal.What} of {reveal.Name} could not be brought into view ({(answer is null ? "the page did not answer" : $"the page answered {answer}")}): they are in the column on the right.";
        TryStateHasChanged();
    }

    /// <summary>
    /// A menu entry is about ONE device: once the selection is anything else, what it asked for no
    /// longer applies - a command is not sent to a device the operator has left, and a part of the
    /// panel is not brought into view for a device the panel no longer shows. The selection the menu
    /// itself makes arrives BEFORE the entry does (the bridge selects, then calls), so it is never
    /// the one that takes the entry away. A notice goes with any selection: it was about the gesture
    /// before it.
    /// </summary>
    private void ForgetTheMenuEntryTheSelectionMadeUntrue(IReadOnlyList<string>? cellIds)
    {
        var onlyDevice = cellIds is [var only] ? _selection.DeviceOf(only)?.ItemId : null;
        if (_menuReveal is { } reveal && reveal.ItemId != onlyDevice) _menuReveal = null;
        if (_menuCommand is { } command && command.ItemId != onlyDevice) _menuCommand = null;
        if (_duplicateQuestion is { } asked && asked.ItemId != onlyDevice) _duplicateQuestion = null;
        if (_missionStepsWindowItemId != onlyDevice) _missionStepsWindowItemId = null;
        if (_linkedCellsWindowItemId != onlyDevice) _linkedCellsWindowItemId = null;
        _menuNotice = null;
    }

    /// <summary>
    /// A command chosen while the engine ran, and not yet taken when it stopped, is not kept for the
    /// next time it runs: that would send it to the device long after the operator chose it.
    /// </summary>
    private void ForgetTheMenuCommandUnlessRunning()
    {
        if (_menuCommand is not { Taken: false } pending || DisplayedNavStatus == NavigatorStatusTypes.Run) return;
        _menuCommand = null;
        _menuNotice = $"{DrawioContextMenu.Of(pending.Command).Label} was NOT sent to {NameOfItem(pending.ItemId)}: the engine stopped running before the panel could send it.";
    }

    /// <summary>
    /// What the bridge needs to build our entries in draw.io's right-click menu, which it builds on
    /// its own and at once (no round trip to this page is possible while draw.io draws a menu): the
    /// cells that ARE devices of the plant - the same answer <see cref="DrawioSelectionCoordinator.DeviceOf"/>
    /// gives, so a junction's arrow or a drawing-only shape gets none - whether the engine runs, by
    /// the same rule as the panel's commands (<see cref="DeviceCommands"/>: the status the page
    /// shows), and which devices are offline, for "Set Ready" in place of "Set Off Line" as the
    /// panel's own button says it. Sent only when it changed.
    /// </summary>
    private async Task SyncDeviceMenuAsync()
    {
        if (_bridgeModule is null || !_bridgeAttached || _disposed) return;

        var running = DisplayedNavStatus == NavigatorStatusTypes.Run;
        var devices = new SortedSet<string>(StringComparer.Ordinal);
        var offline = new SortedSet<string>(StringComparer.Ordinal);
        if (_graph is { } graph)
        {
            var known = new HashSet<Guid>();
            var offlineItems = new HashSet<Guid>();
            foreach (var item in graph.Items)
            {
                known.Add(item.ItemId);
                devices.Add(item.ItemId.ToString());
                if (_live?.StatusOf(item.ItemId)?.Status == DeviceStatusTypes.OffLine)
                {
                    offlineItems.Add(item.ItemId);
                    offline.Add(item.ItemId.ToString());
                }
            }

            foreach (var (cellId, itemId) in _plantItemByDrawnCell)
            {
                if (!known.Contains(itemId)) continue;
                devices.Add(cellId);
                if (offlineItems.Contains(itemId)) offline.Add(cellId);
            }
        }

        var said = $"{running}|{string.Join(",", devices)}|{string.Join(",", offline)}";
        if (said == _deviceMenuSaid) return;
        _deviceMenuSaid = said;
        try
        {
            await _bridgeModule.InvokeVoidAsync("setDeviceMenu", running, devices.ToArray(), offline.ToArray());
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Said again at the next render or frame: the menu offers what it was last told, and an
            // entry chosen from a stale menu is judged again here, on what the page knows now.
            _deviceMenuSaid = null;
        }
    }

    /// <summary>What <see cref="SyncDeviceMenuAsync"/> last told the bridge, so that it tells again only a change.</summary>
    private string? _deviceMenuSaid;

    /// <returns>
    /// Null when the drawing took the name; otherwise the words that end the creation's line, with what
    /// the page's script threw behind the line's "?" (row 37 of the queue, extended to the whole page on
    /// 10/10).
    /// </returns>
    private async Task<DrawioSaid?> CanvasTakesTheNameAsync(string cellId, string name)
    {
        const string stale = ": the shape keeps the label it had until the page is reloaded.";
        if (_bridgeModule is null) return $" The drawing could not be told{stale}";

        try
        {
            if (!await _bridgeModule.InvokeAsync<bool>("renameCell", cellId, name, true))
                return $" The drawing did not take that name (the cell is no longer there, or the selection could not be followed){stale}";
        }
        catch (Exception ex)
        {
            return DrawioSaid.Failed($" The drawing could not be told, because {DrawioFailureWords.WhyTheScriptDidNotAnswer(ex)}{stale}", ex);
        }

        return null;
    }

    private async Task<IReadOnlyList<DrawioMarkedCell>?> ReadMarkedCellsAsync()
    {
        if (_bridgeModule is null) return null;
        try
        {
            return await _bridgeModule.InvokeAsync<DrawioMarkedCell[]?>("markedCells");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            return null;
        }
    }

    // alreadyOnThePlant tells the bridge whether the model edit it is about to make is an echo of a
    // write the plant already holds (true - the ordinary case, the config panel's rename) or real
    // unsaved work (false - the re-pointing gesture, row 15: the shape/device pair only reaches the
    // plant at the next save). See renameCell in drawio-bridge.js.
    private async Task<DrawioCanvasRenameResult> RenameCellAsync(string cellId, string? name, bool alreadyOnThePlant)
    {
        if (_bridgeModule is null) return new(false, false, null);
        try
        {
            return new(await _bridgeModule.InvokeAsync<bool>("renameCell", cellId, name ?? "", false, alreadyOnThePlant), true, null);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            return new(false, false, ex.Message);
        }
    }

    private async Task SeedDrawioAsync()
    {
        if (_bridgeModule is null || !_drawioReady || _graph is not { } graph) return;

        _documentSent = false;

        _plantJunctionByDrawnEdge.Clear();
        _plantItemByDrawnCell.Clear();

        if (_liveModule is not null)
        {
            // The overlays are on cells that the load below replaces. A live module that does not
            // answer is not a drawing that did not arrive: it is kept apart from the load's failure.
            try
            {
                await _liveModule.InvokeVoidAsync("forget");
            }
            catch (Exception ex) when (ex is not OutOfMemoryException)
            {
                // Whatever it is, it is not fatal: the overlays are secondary and the drawing is not.
                // A forget that did not happen leaves at worst an overlay on a cell about to go; the
                // next frame is drawn on the new document either way.
            }
        }

        try
        {
            await _bridgeModule.InvokeVoidAsync("load", _iframeElement, DrawioDocument.Build(graph, _decorationXml));
            _documentSent = true;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            SetBridgeUnavailable(DocumentNotSentMessage);
        }

        // The new drawing has none of the live status yet: the whole frame goes to it at once.
        await RefreshLiveAsync();
    }

    /// <summary>
    /// The drawing draw.io handed over for a save. The answer goes back to the bridge, and it is
    /// what puts down the mark that makes closing the tab ask "Leave site?" (row 46): true only for
    /// a round that wrote everything - see <see cref="DrawioSaveCoordinator.SavedAsync(string)"/>.
    /// </summary>
    /// <remarks>
    /// Not what the bridge calls since queue item 13: the drawing does not cross the circuit as one
    /// message any more - see <see cref="OnDrawioHandedTheDrawingOver"/>, which takes it and then runs
    /// this same round on it.
    /// </remarks>
    public Task<bool> OnDrawioSaved(string xml) => _save.SavedAsync(xml);

    /// <summary>
    /// Queue item 13: draw.io handed a drawing over for a save, and the bridge keeps it under the
    /// number <paramref name="drawing"/>: the page takes it as a stream (the bridge's
    /// <c>handedOverDrawing</c>, see <see cref="DrawioDrawingTransfer"/>) and runs the save round on it,
    /// with the same answer as <see cref="OnDrawioSaved"/>: true only for a round that wrote everything.
    /// Still called <c>OnDrawioSaved</c> from the bridge: it is the same event.
    /// </summary>
    [JSInvokable(nameof(OnDrawioSaved))]
    public Task<bool> OnDrawioHandedTheDrawingOver(long drawing)
    {
        // Queue item 14: this number reached the page, whatever its round does next - a drop of the
        // connection did not take it. And a new save makes the line about a lost one stale.
        _savesAccountedFor.Add(drawing);
        _saveLostInADrop = false;
        _saveMayHaveBeenWritten = false;
        return RunTheSaveRoundAsync(drawing);
    }

    private async Task<bool> RunTheSaveRoundAsync(long drawing)
    {
        try
        {
            var round = await _save.RoundAsync(async () => _bridgeModule is { } bridge
                ? await DrawioDrawingTransfer.FetchAsync(bridge, "handedOverDrawing", [drawing])
                  // No bytes: the bridge no longer holds that number (it lets go at a detach), or draw.io
                  // handed over nothing. Said as that, and not as a drawing that is "not XML".
                  ?? throw new DrawioDrawingNotReceivedException(
                      "there was no drawing under the number the save was handed over with - draw.io handed over nothing, or the page had already let go of it. Press Save again")
                : throw new DrawioDrawingNotReceivedException("the page is no longer connected to draw.io - reload it"));
            // Final fix round, C1: a round that stopped before writing anything is not said, at a drop
            // that takes its answer, as a save that may have been written.
            if (round == DrawioSaveRound.WroteNothing) _saveRoundsThatWroteNothing.Add(drawing);
            return round == DrawioSaveRound.WroteEverything;
        }
        finally
        {
            // Final review, C18: the round is over and the page will not ask for its drawing again. If
            // its answer is lost in a drop, the bridge's call never settles and the bridge would hold
            // the drawing for good; the next drop's coming back lets go of it.
            _saveRoundsOver.Add(drawing);
        }
    }

    private const string SaveLostInADropMessage =
        "The connection dropped during the save; nothing was written, press Save again.";

    private const string SaveMayHaveBeenWrittenMessage =
        "The connection dropped while the plant was being saved: the save may have been written. Reopen the plant to see what it holds.";

    private const string ConnectionCameBackMessage =
        "The connection to the host dropped and came back: what you did in that moment may not have reached the page.";

    /// <summary>
    /// Queue item 14: the numbers of the saves that reached this page (<see cref="OnDrawioHandedTheDrawingOver"/>),
    /// and of those already said lost. A number the bridge still holds after a drop and that is not
    /// among these is a call the drop took; one that reached the page went to the host, and its outcome
    /// had not come back to the browser - its round may still be running, and its answer will still get
    /// there, or have ended with its answer lost in the drop (task 12: "the save may have been written",
    /// unless the round wrote nothing). Each is said once, at the drop that finds it (<see cref="_savesSaidAtADrop"/>), and not again at every drop after - a call that
    /// never settles stays in the bridge until the page tells it to let go (<see cref="_saveRoundsOver"/>).
    /// One per save, never pruned: a number taken out while its round runs would read as lost at the
    /// next drop.
    /// </summary>
    private readonly HashSet<long> _savesAccountedFor = [];

    /// <summary>
    /// Queue item 14 and task 12: the saves a drop has been said about - lost, or that may have been
    /// written. Said once each. Never a round still running: its answer reaches the bridge on the
    /// connection that came back, and its own report says what it wrote (final fix round, C1).
    /// </summary>
    private readonly HashSet<long> _savesSaidAtADrop = [];

    /// <summary>
    /// Final review, C18: the numbers whose round has ended on this page. With the lost ones, they are
    /// what the bridge is told to let go of when a drop comes back (<c>letGoOfSaves</c>): a call that
    /// never settles - the save's, or its answer's on the way back - kept the whole drawing in the
    /// browser for the rest of the session, one copy of the plant per save a drop took.
    /// </summary>
    private readonly HashSet<long> _saveRoundsOver = [];

    /// <summary>
    /// Final fix round, C1: the rounds among <see cref="_saveRoundsOver"/> that stopped before writing
    /// anything - refused at the gate, or whose drawing did not arrive. Their answer lost in a drop is
    /// no save that may have been written: the page knows nothing was.
    /// </summary>
    private readonly HashSet<long> _saveRoundsThatWroteNothing = [];

    /// <summary>How many times the circuit's connection came back: each one is a new outcome in the row.</summary>
    private long _connectionDrops;

    /// <summary>A drop took a save's call: said until the next save reaches the page.</summary>
    private bool _saveLostInADrop;

    /// <summary>How many drops took a save: each one is a new outcome in the row, as a refused cut.</summary>
    private long _savesLostInADrop;

    /// <summary>Task 12: a drop crossed a save that had reached the page: said until the next save reaches it.</summary>
    private bool _saveMayHaveBeenWritten;

    /// <summary>Task 12: how many drops crossed such a save: each one is a new outcome in the row.</summary>
    private long _savesMayHaveBeenWritten;

    /// <summary>Raised by the session (<see cref="EditorSessionState.ConnectionCameBack"/>) on whatever thread Blazor's handler runs.</summary>
    private void OnConnectionCameBack()
    {
        if (_disposed) return;
        _ = InvokeAsync(SayWhatTheDropMayHaveTakenAsync);
    }

    /// <summary>
    /// Queue item 14: the line every drop gets, and the save's when the bridge still holds the number
    /// of a save that never reached the page - its call was sent while the connection was down, and
    /// Blazor neither sends it again nor settles it. Task 12: and when it holds the number of one that
    /// did reach the page and whose round ended with its answer lost in the drop - the round went to the
    /// host, and what it wrote is not known from there. Not for a round still running, whose answer
    /// comes on the connection that came back, nor for one that stopped before writing anything
    /// (final fix round, C1).
    /// </summary>
    private async Task SayWhatTheDropMayHaveTakenAsync()
    {
        if (_disposed) return;
        _connectionDrops++;
        if (_bridgeAttached && _bridgeModule is { } bridge)
        {
            try
            {
                // Final fix round, C1: the rounds that ended before the bridge is asked. One that ends
                // while it answers does so on the connection that came back, and its answer gets there.
                var overBeforeAsking = _saveRoundsOver.ToHashSet();
                var held = await bridge.InvokeAsync<long[]>("savesHandedOver");
                var lost = held.Where(drawing => !_savesAccountedFor.Contains(drawing)).ToList();
                if (lost.Count > 0)
                {
                    _savesAccountedFor.UnionWith(lost);
                    _savesSaidAtADrop.UnionWith(lost);
                    _saveLostInADrop = true;
                    _savesLostInADrop++;
                }

                // Task 12: a round that reached the page, ended, and whose answer the drop took - and not
                // one still running, nor one the page knows wrote nothing (final fix round, C1).
                var mayHaveBeenWritten = held
                    .Where(drawing => !lost.Contains(drawing)
                        && overBeforeAsking.Contains(drawing)
                        && !_saveRoundsThatWroteNothing.Contains(drawing)
                        && _savesSaidAtADrop.Add(drawing))
                    .ToList();
                if (mayHaveBeenWritten.Count > 0)
                {
                    _saveMayHaveBeenWritten = true;
                    _savesMayHaveBeenWritten++;
                }

                // Final review, C18: what nobody will ask for again - the lost ones, and the ones whose
                // round is over - and not a round still running, which takes its drawing by itself.
                var done = held.Where(drawing => lost.Contains(drawing) || _saveRoundsOver.Contains(drawing)).ToArray();
                if (done.Length > 0) await bridge.InvokeVoidAsync("letGoOfSaves", (object)done);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
            {
                // The bridge could not be asked - the connection dropped again, most likely: the line
                // of the drop is said anyway, and the next one asks again.
            }
        }

        TryStateHasChanged();
    }

    private async Task<DrawioSaid?> ImportThroughTheGateAsync(Func<Task> write)
    {
        if (!_writeGate.TryEnter(DrawioPlantWriter.Importing, out var writeLease))
        {
            return DrawioWriteRefusal.ForImport(_writeGate.Current);
        }

        using var importLease = writeLease!;
        if (await EnsureWritableAsync() is { } refused)
            return refused;
        // Owner's decision of 27/9 on Pause: a plant is imported only with the engine stopped - Run,
        // Recover and Dispose are refused above (CanEdit), Pause here, at write time.
        if (_navStatus == NavigatorStatusTypes.Pause)
            return "Nothing was sent: the engine is paused, and a plant is imported only with the engine stopped - an import rebuilds every device without its connection, and resuming from Pause does not open them again.";

        try
        {
            await write();
        }
        catch (WcsApiException ex) when (ex.StatusCode is HttpStatusCode.Conflict or HttpStatusCode.BadRequest or HttpStatusCode.Locked)
        {
            // REFUSED BEFORE ANYTHING WAS WRITTEN (row 46, second half of the owner's decision of
            // 2026-09-25; fix round 1 added Locked). Conflict/BadRequest: the host validates the
            // whole replacement before it touches the database (GraphEndpoints), and these two codes
            // are its way of saying so - work in progress, or an invalid file. Locked: the SAME
            // route requires the edit permit (RequiresEditPermission -> EditPermissionFilter), which
            // runs as a filter BEFORE the endpoint body - a permit that expired, or was taken by
            // another circuit, in the moment between EnsureWritableAsync's own check above and the
            // PUT actually landing on the host answers 423 before anything is touched either. All
            // three are refusals of the SAME shape, and ImportExport's own catch for them does not
            // reload the page: the drawing on the canvas is exactly the one the operator has been
            // drawing on, unsaved work and all, so nothing here forgets it.
            throw;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or WcsApiException)
        {
            // The write was ATTEMPTED and its outcome is NOT known - a dropped connection, a timeout,
            // a 5xx, or a WcsApiException of some OTHER status than the three refusals just above.
            // This is exactly the set ImportExport.ConfirmImportAsync's own general catch recognizes
            // (fix round 1: it used to be "anything but OutOfMemoryException", which is wider than
            // that catch and would have forgotten the unsaved work even for a failure ImportExport
            // does not reload for - a lie about what is about to happen next). For everything in
            // this set ImportExport DOES reload the page UNCONDITIONALLY (the canvas may be drawing
            // a plant that is no longer there), and that reload must not ask "Leave site?" about a
            // drawing the operator can no longer trust either way. Forgotten here, before the
            // exception reaches that catch, for the same reason a write that went through forgets
            // below - and ForgetUnsavedWorkAsync itself never throws towards its caller, so this
            // cannot turn one failure into two.
            await ForgetUnsavedWorkAsync();
            throw;
        }

        await ForgetUnsavedWorkAsync();
        return null;
    }

    /// <summary>
    /// The whole plant may have just been replaced by an import, and ImportExport reloads the page
    /// next: what the canvas holds is superseded by the operator's own confirmed choice - or may be,
    /// which is just as much a reason not to trust it - so the reload must not ask "Leave site?".
    /// Called from <see cref="ImportThroughTheGateAsync"/> in the TWO cases where the write was
    /// ATTEMPTED (fix round 1: not only the one where it plainly went through) - a success, or an
    /// outcome left unknown by a dropped connection, a timeout or a 5xx - and in neither case of a
    /// REFUSAL that left the plant untouched (409/400/423, all caught before this is ever reached):
    /// a refused import leaves the drawing - and its unsaved work - exactly where it was, and nothing
    /// here has a reason to forget it.
    /// </summary>
    private async Task ForgetUnsavedWorkAsync()
    {
        if (_bridgeModule is null) return;
        try
        {
            await _bridgeModule.InvokeVoidAsync("forgetUnsavedWork");
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // WHATEVER it is, it stops here. This runs right after a write that went through OR
            // whose outcome is unknown - either way ImportExport is about to reload the page - and
            // anything thrown from here would reach ImportExport as a failure of the import itself
            // (the "outcome unknown" warning, wrongly, about a write that may have succeeded) or
            // escape it with no reload at all. Not forgotten only means the reload that follows asks
            // "Leave site?" once too often, which is the side a doubt is allowed to fall on.
        }
    }

    /// <summary>
    /// Row 50 (task 1): the write gate and the edit permit, in the same shape as
    /// <see cref="ImportThroughTheGateAsync"/> - <see cref="DrawioPlantWriter.Mode"/> instead of
    /// <see cref="DrawioPlantWriter.Importing"/>. It only decides the refusals that are known BEFORE
    /// any write is attempted: another writer already holding the gate, or
    /// <see cref="EnsureWritableAsync"/> saying read-only (permit denied, or the engine already Run
    /// per the page's own cached status) - both RETURNED as a string, never thrown.
    /// </summary>
    /// <remarks>
    /// Fix round 1, item 12 (this summary used to contradict itself): whatever <c>write()</c> itself
    /// throws - a 409 if the engine starts running in the exact window after
    /// <see cref="EnsureWritableAsync"/> already passed (<c>PlantQueries.SetConnectionTypeForAllAsync</c>
    /// /<c>RequireNotRunning</c>), a 423 if the permit is lost in that same window, or a transport
    /// failure - is NOT caught here: it propagates to <c>DrawioOperations.ConfirmModeAsync</c>, which
    /// tells apart a clean refusal, an unknown outcome, and a write that went through but whose
    /// following reread failed (fix round 1, IMPORTANT 4) - a distinction this method cannot make on
    /// its own, since it does not know whether it is <c>write()</c> itself or the caller's own reread
    /// afterwards (<see cref="ReloadPlantItemsAsync"/>, invoked by DrawioOperations through its
    /// <c>OnModeWritten</c> parameter, not called from here at all) that eventually fails.
    /// </remarks>
    private Task<DrawioSaid?> ModeThroughTheGateAsync(Func<Task> write) =>
        _writeGate.WriteThroughAsync(DrawioPlantWriter.Mode, DrawioWriteRefusal.ForMode, ModeWritableAsync, write);

    /// <summary>
    /// Owner's decision of 27/9 (D1): the edit permit, as for every write, and the engine STOPPED - the
    /// same rule as the PLC connections (<see cref="PlcConnectionsWritableAsync"/>), and the host's
    /// (PlantQueries.SetConnectionTypeForAllAsync, RequireStopped). The engine gives each device the
    /// simulator or the PLC only when it opens the connections (DeviceConnections.OpenConnection), and
    /// resuming from Pause does not reopen them (ExecutableCommands.StartNavigator): switched in Pause,
    /// the plant would say one mode while the engine keeps driving the other.
    /// </summary>
    private async Task<DrawioSaid?> ModeWritableAsync()
    {
        var refused = await EnsureWritableAsync();
        if (_lockDenied is null && _navStatus is { } status && status != NavigatorStatusTypes.Stop)
            return $"Connection mode was NOT written: the engine is {EngineStateWords(status)}, and the connection mode is switched only with the engine stopped - {WhyTheModeWaitsFor(status)}. Nothing was written.";
        return refused is null ? null : refused with { Text = $"Connection mode was NOT written. {refused.Text}" };
    }

    /// <summary>
    /// Owner's decision of 27/9 on Pause: a device is created (the palette's drop) or duplicated only
    /// with the engine STOPPED, as the host requires (PlantQueries.CreateItemConfigurationAsync,
    /// RequireStopped): it would be born without its connection - the engine gives devices the
    /// simulator or the PLC only when it opens the connections (DeviceConnections.OpenConnection), and
    /// resuming from Pause does not open them again (ExecutableCommands.StartNavigator). Run, Recover
    /// and Dispose are refused by <see cref="EnsureWritableAsync"/> itself, in its own words; Pause here.
    /// </summary>
    private async Task<DrawioSaid?> NewDevicesWritableAsync(string gesture)
    {
        var refused = await EnsureWritableAsync();
        if (refused is null && _navStatus == NavigatorStatusTypes.Pause)
            return $"The engine is paused, and a device is {gesture} only with the engine stopped: {NewDeviceWhy}";
        return refused;
    }

    /// <summary>Why a new device waits for Stop - the reason <see cref="NewDevicesWritableAsync"/> and the duplicate's question give.</summary>
    internal const string NewDeviceWhy =
        "it would be born without its connection - the engine gives devices the simulator or the PLC only when it opens the connections, and resuming from Pause does not open them again.";

    /// <summary>
    /// What the duplicate's question says while the page SHOWS an engine that is not stopped - the
    /// answer is held until it is (owner's decision of 27/9 on Pause; the write checks again).
    /// </summary>
    private string? DuplicateNotNow => DisplayedNavStatus is { } status && status != NavigatorStatusTypes.Stop
        ? $"Not now: the engine is {EngineStateWords(status)}, and a device is duplicated only with the engine stopped" +
          (status == NavigatorStatusTypes.Pause ? $": {NewDeviceWhy}" : ".")
        : null;

    /// <summary>Why the connection mode waits for Stop, said for the state the engine is in (see <see cref="ModeWritableAsync"/>).</summary>
    private static string WhyTheModeWaitsFor(NavigatorStatusTypes status) => status switch
    {
        NavigatorStatusTypes.Run => "while it runs, the engine drives every device with the simulator or the PLC it gave it when it opened the connections",
        NavigatorStatusTypes.Pause => "the engine gives a device the simulator or the PLC only when it opens the connections, and resuming from Pause does not reopen them",
        _ => "until it is stopped, the engine may be opening or using the connections",
    };

    /// <summary>
    /// Row 62 (compito 4): the save of the PLC connections through the write gate and the edit permit
    /// (<see cref="DrawioPlantWriteGate.WriteThroughAsync"/>, the same as the connection mode's), with
    /// <see cref="DrawioPlantWriter.PlcConnections"/> and the refusals worded for the grid, which keeps
    /// what was typed. What <c>write()</c> throws is the grid's to tell apart
    /// (DrawioPlcConnections.ConfirmSaveAsync).
    /// </summary>
    private Task<DrawioSaid?> PlcConnectionsThroughTheGateAsync(Func<Task> write) =>
        _writeGate.WriteThroughAsync(DrawioPlantWriter.PlcConnections, DrawioWriteRefusal.ForPlcConnections, PlcConnectionsWritableAsync, write,
            afterUnreadablePermit: "Your changes are still in the grid.");

    /// <summary>
    /// The edit permit, as for every write, and the engine STOPPED - not only "not running", which is
    /// all <see cref="EnsureWritableAsync"/> refuses (<see cref="CanEdit"/>): paused, the engine still
    /// holds the PLC connections open, and resuming from Pause does not reopen them
    /// (<c>ExecutableCommands.StartNavigator</c> skips <c>OpenDeviceConnections</c> when paused).
    /// </summary>
    /// <remarks>
    /// <b>The host has the same rule since Task 4b</b> (<c>PUT /plc/connections</c> with
    /// <c>RequiresEditPermission</c>, <c>PlcSettingsFacade.ReplaceAsync</c> refusing any state but Stop
    /// with 409): the page refuses first and says why in its own words; the host's 409 is left for an
    /// engine started from elsewhere between this check and the PUT (DrawioPlcConnections.HostRefusal).
    /// The status judged is this call's own: when the
    /// permit request fails, <see cref="EnsureWritableAsync"/> clears it before returning, and the
    /// permit is the reason.
    /// </remarks>
    private async Task<DrawioSaid?> PlcConnectionsWritableAsync()
    {
        var refused = await EnsureWritableAsync();
        if (_lockDenied is null && _navStatus is { } status && status != NavigatorStatusTypes.Stop)
            return $"The PLC connections were NOT saved: the engine is {EngineStateWords(status)}, and they are saved only with the engine stopped - {WhyNotWith(status)}. Nothing was written; your changes are still in the grid.";
        return refused is null ? null : refused with { Text = $"The PLC connections were NOT saved. {refused.Text} Your changes are still in the grid." };
    }

    private static string EngineStateWords(NavigatorStatusTypes status) => status switch
    {
        NavigatorStatusTypes.Run => "running",
        NavigatorStatusTypes.Pause => "paused",
        NavigatorStatusTypes.Recover => "recovering",
        NavigatorStatusTypes.Dispose => "shutting down",
        _ => status.ToString(),
    };

    /// <summary>Why the PLC connections wait for Stop, said for the state the engine is in (see <see cref="PlcConnectionsWritableAsync"/>).</summary>
    private static string WhyNotWith(NavigatorStatusTypes status) => status switch
    {
        NavigatorStatusTypes.Run => "while it runs, the engine is using the PLC connections it built when the plant was loaded",
        NavigatorStatusTypes.Pause => "while paused, the engine keeps its PLC connections open, and resuming does not reopen them",
        _ => "until it is stopped, the engine may be building or using its PLC connections",
    };

    /// <summary>
    /// Rereads just the plant's devices (row 50's brief: "and then rereads the plant"), without resending
    /// anything to the drawio bridge: <see cref="Wcs.WebEditor.Model.PlantGraph.LoadAsync"/> fills the
    /// SAME <see cref="_graph"/> instance in place, so DrawioOperations - which was handed that same
    /// reference - reads the new values on its very next render without a fresh parameter from here.
    /// </summary>
    /// <remarks>
    /// Fix round 1, CRITICAL 1: also forces the properties panel to reread the SELECTED device's own
    /// configuration (<see cref="DrawioSelectionCoordinator.ForceRefreshSelectedConfigAsync"/>), even
    /// though the selection itself has not moved. Without this, a device selected before the mode
    /// switch kept the panel's STALE <c>ConnectionType</c> in <c>_selectedConfig</c>; the next save on
    /// ANY other field of that same panel would send the whole configuration back, including that
    /// stale value - silently undoing the switch on whichever device happened to be selected. This
    /// call never throws (it swallows its own read failures into <c>ConfigError</c>), so it cannot
    /// turn a successful plant-wide write into this method reporting a reread failure that was really
    /// only about the panel.
    /// <para>
    /// Fix round 2, MINOR 2: the panel reread runs from a <c>finally</c>, so it still happens even
    /// when the plant-wide reread above (<c>graph.LoadAsync</c>) itself fails - a stale panel must
    /// never be left showing a value nobody can trust any more just because a DIFFERENT read failed.
    /// </para>
    /// <para>
    /// Final review, M2: the plant reread's failure is RETURNED, not rethrown, next to whether the
    /// panel was cleared - DrawioOperations.ConfirmModeAsync needs both to say "WAS written, but not
    /// read again" AND that what was typed into the panel is gone. A rethrown failure could not carry
    /// the second fact, and the line used to leave it out. A failure of any other kind still
    /// propagates, after the panel's own reread.
    /// </para>
    /// </remarks>
    private async Task<DrawioModeReread> ReloadPlantItemsAsync()
    {
        Exception? plantRereadFailure = null;
        var panelWasReread = false;
        try
        {
            if (_graph is { } graph) await graph.LoadAsync(State.Client);
        }
        catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException or System.Text.Json.JsonException)
        {
            plantRereadFailure = ex;
        }
        finally
        {
            panelWasReread = await _selection.ForceRefreshSelectedConfigAsync();
        }

        return new DrawioModeReread(panelWasReread, plantRereadFailure);
    }

    /// <summary>
    /// The edit permit asked for NOW, and the engine's state read for the write: null lets it through,
    /// otherwise its refusal. A permit that could not be asked for is said in one sentence with the why,
    /// and what came back - the host's answer as it came, or the failure's own message - is behind the
    /// "?" of whichever line says it (row 37 of the queue: the panel, the save, the device list, the PLC
    /// connections, the connection mode, the engine's start, the creation, the Plant file window).
    /// </summary>
    private async Task<DrawioSaid?> EnsureWritableAsync()
    {
        try
        {
            var lease = await State.Client.AcquireEditLockAsync(State.Holder);
            _lockDenied = lease.IsMine ? null : lease;
            _lockEverGranted |= lease.IsMine;
        }
        catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException)
        {
            // Returned BEFORE the status is read: what an earlier call left in _navStatus is not this
            // call's answer, and a caller that judged it would give an old reason - "the engine is
            // already running" (EnsureEngineCanStartAsync), "paused" (the PLC connections) - instead
            // of this one. Cleared to unknown, so every caller gives the permit as the reason; every
            // caller's own test of the engine state needs a known status. (CanEdit is then false, as
            // it must be for a write that was not let through.)
            _navStatus = null;
            return DrawioSaid.Failed($"The edit permit could not be asked for because {DrawioFailureWords.Why(ex)}: nothing was written.", ex);
        }

        await RefreshEngineStatusAsync();

        if (CanEdit) return null;

        return _lockDenied is { } denied
            ? $"Read only: somebody else has been editing the plant since {denied.SinceLocal:HH:mm:ss}. Nothing was written."
            : _navStatus switch
            {
                NavigatorStatusTypes.Run => "Read only: the engine is running - stop it before changing the plant. Nothing was written.",
                NavigatorStatusTypes.Recover => "Read only: the engine is recovering - it is loading the plant, and stops by itself when it has finished: write then. Nothing was written.",
                NavigatorStatusTypes.Dispose => "Read only: the engine is shutting down. Nothing was written.",
                _ => "Read only: the engine status is not known, and to be safe no write is made. Nothing was written.",
            };
    }

    /// <summary>
    /// The edit permit for a start, as for any write - worded for the engine. Its own GET may say Run
    /// while what the page shows does not know it yet (the live event is still on its way): then the
    /// engine is not "NOT started", it is already running.
    /// </summary>
    private async Task<DrawioSaid?> EnsureEngineCanStartAsync()
    {
        if (await EnsureWritableAsync() is not { } refused) return null;
        // Worded for a START (confirmation review, M-C): EnsureWritableAsync's own sentences are for a
        // write ("... write then").
        return _lockDenied is not null
            ? refused with { Text = $"The engine was NOT started. {refused.Text}" }
            : _navStatus switch
            {
                NavigatorStatusTypes.Run => "The engine is already running (the host says so): nothing was sent.",
                NavigatorStatusTypes.Recover => "The engine was NOT started: it is recovering - loading the plant - and stops by itself when it has finished: start it then.",
                NavigatorStatusTypes.Dispose => "The engine was NOT started: it is shutting down.",
                _ => refused with { Text = $"The engine was NOT started. {refused.Text}" },
            };
    }

    /// <summary>
    /// The edit permit the engine's start took, given back once the start is over, whatever its end:
    /// held for the rest of the minute, it would refuse the other pages with "somebody else has been
    /// editing". The coordinator calls this while it still holds the write gate, so no write of this
    /// page can be under way with the same permit; the host releases it only if it is this holder's.
    /// </summary>
    private async Task ReleaseStartPermitAsync()
    {
        if (_disposed || !State.HasKey) return;
        try
        {
            await State.Client.ReleaseEditLockAsync(State.Holder);
        }
        catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException)
        {
            // Not given back: it expires by itself within the minute.
        }
    }

    /// <summary>
    /// What the save would write if it ran now, read off the drawing WITHOUT saving it: the same three
    /// inputs as the save (the drawing, the plant as opened, the plant now), the same comparison.
    /// Null when there is nothing; otherwise the sentence that says why the engine was not started -
    /// with what came back, when a call failed, behind its "?" (row 37 of the queue, extended to the
    /// whole page on 10/10).
    /// </summary>
    private async Task<DrawioSaid?> UnsavedWorkAsync()
    {
        const string unknown =
            "It cannot be known whether the drawing holds unsaved work ({0}), so the engine was NOT started. Reload the page.";

        if (_bridgeModule is null || _graph is not { } opened || !_documentSent)
            return string.Format(unknown, "the drawing has not reached draw.io");

        string? xml;
        try
        {
            // As a stream, not as one message: see DrawioDrawingTransfer (queue item 13).
            xml = await DrawioDrawingTransfer.FetchAsync(_bridgeModule, "currentDrawing", []);
        }
        catch (DrawioDrawingNotReceivedException ex)
        {
            // The message is the page's own words; what the browser threw, if anything, is the inner one.
            return new DrawioSaid(string.Format(unknown, ex.Message), ex.InnerException is { } failure ? DrawioFailureWords.Detail(failure) : null);
        }

        if (xml is null) return string.Format(unknown, "draw.io did not hand the drawing over");

        DrawioContents drawn;
        try
        {
            drawn = DrawioReader.Read(xml);
        }
        catch (XmlException ex)
        {
            return DrawioSaid.Failed(string.Format(unknown, "the drawing that came back from draw.io is not readable as XML"), ex);
        }

        if (drawn.Diagrams > 1)
            return "The drawing has more than one page, and the save refuses it: the engine was NOT started. Reload the page first.";

        // The save's own guard (DrawioSaveCoordinator): a drawing with none of the cells that were
        // sent is not the plant's, and the save refuses it as a whole - "save first" would be advice
        // the save does not take.
        var cellsDrawn = drawn.Devices.Count + drawn.Junctions.Count + drawn.Unknown.Count;
        var cellsSent = opened.Items.Count(item => DrawioDocument.IsDrawn(opened, item))
            + opened.Junctions.Count(junction => DrawioDocument.IsDrawn(opened, junction));
        if (cellsDrawn == 0 && cellsSent > 0)
            return $"The drawing that came back from draw.io holds none of the {cellsSent} plant cells that had been sent to it: it is not the plant's drawing, the save would refuse it, and the engine was NOT started. Reload the page.";

        var current = new PlantGraph();
        try
        {
            await current.LoadAsync(State.Client);
        }
        catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException)
        {
            return DrawioSaid.Failed(string.Format(unknown, $"the plant could not be read from the host because {DrawioFailureWords.Why(ex)}"), ex);
        }

        return DrawioUnsavedWork.Describe(
            DrawioDelta.Compute(drawn, opened, current, _plantJunctionByDrawnEdge, _plantItemByDrawnCell));
    }

    private static string NameOf(PlantItemDto item) =>
        item.Name is { Length: > 0 } name ? name : item.ItemId.ToString();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _gone.Cancel();
        _save.Changed -= OnCoordinatorChanged;
        _selection.Changed -= OnCoordinatorChanged;
        _creation.Changed -= OnCoordinatorChanged;
        _duplication.Changed -= OnCoordinatorChanged;
        _engine.Changed -= OnCoordinatorChanged;
        _writeGate.Changed -= OnWriteGateChanged;
        State.ConnectionCameBack -= OnConnectionCameBack;

        // Nothing of the live status may keep the bridge from detaching or the edit permit from
        // being released below: its failures stop here, whatever they are.
        // The live module is cleared first: its hover callbacks stop before the feed does, instead of
        // reaching a page whose channel is being closed.
        if (_liveModule is not null)
        {
            try
            {
                await _liveModule.InvokeVoidAsync("clear");
            }
            catch (Exception ex) when (ex is not OutOfMemoryException)
            {
            }
        }

        if (_live is not null)
        {
            try
            {
                await _live.DisposeAsync();
            }
            catch (Exception ex) when (ex is not OutOfMemoryException)
            {
            }
        }

        if (_liveModule is not null)
        {
            try
            {
                await _liveModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is not OutOfMemoryException)
            {
            }
        }

        if (_bridgeModule is not null)
        {
            try
            {
                await _bridgeModule.InvokeVoidAsync("detach");
                await _bridgeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _bridgeCallbackRef?.Dispose();

        if (_windowsModule is not null)
        {
            try
            {
                await _windowsModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
            {
                // Only the page's reference to the module goes: the windows detach themselves.
            }
        }

        if (_lockEverGranted && State.HasKey)
        {
            try
            {
                await State.Client.ReleaseEditLockAsync(State.Holder);
            }
            catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException)
            {
            }
        }

        // Cancelled first thing above; whatever still holds its token sees it cancelled.
        _gone.Dispose();
    }

    /// <summary>
    /// Takes the cells of the devices somebody else deleted off the canvas (coda dei lavori voce 7,
    /// owner's decision of 27/9): true only when the bridge says they are gone. A page with no bridge,
    /// a bridge that answers anything else, or one that could not be reached is "not taken off" - and
    /// the save's report then tells the operator to delete them by hand.
    /// </summary>
    /// <remarks>
    /// The list travels as ONE argument: handed over as it is, a string[] would be taken for the
    /// params array of InvokeAsync and every identifier would arrive as an argument of its own.
    /// </remarks>
    private async Task<bool> TakeOffTheCanvasAsync(IReadOnlyList<string> cellIds)
    {
        if (_bridgeModule is null) return false;
        try
        {
            return await _bridgeModule.InvokeAsync<string?>("removeDeletedDeviceCells", new object?[] { cellIds.ToArray() }) == "ok";
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            return false;
        }
    }
}
