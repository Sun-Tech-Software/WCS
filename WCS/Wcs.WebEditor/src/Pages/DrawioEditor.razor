    private void CloseLinkedCellsWindow() => _linkedCellsWindowItemId = null;

    /// <summary>The id of each section's window: the one DrawioWindow renders, and the one drawio-windows.js remembers it by.</summary>
    private static readonly IReadOnlyList<(DrawioSection Section, string Id)> WindowIds =
    [
        (DrawioSection.PlantFile, "drawio-plant-file"),
        (DrawioSection.Operations, "drawio-operations"),
        (DrawioSection.Devices, "drawio-device-list"),
        (DrawioSection.Junctions, "drawio-junction-list"),
        (DrawioSection.Missions, "drawio-mission-list"),
        (DrawioSection.PlcConnections, "drawio-plc-connections"),
        (DrawioSection.Checks, "drawio-checks"),
    ];

    /// <summary>The windows module (DrawioWindow.ModulePath), imported by the page for the memory of which windows are open; null without it.</summary>
    private IJSObjectReference? _windowsModule;

    /// <summary>
    /// Once, when the strip is first on the page: the windows that were open at the end of the last
    /// visit, in this browser, open again - stacked as they were then, the one in front again in front
    /// and with the focus, which the module sees to when it shows them (drawio-windows.js,
    /// openedLastTime and show; draw.io takes the focus when it loads the plant a moment later, and
    /// drawio-bridge.js gives it back). Without the module, or with a memory it cannot read, none
    /// does: the page starts as it always has, every window shut.
    /// </summary>
    private async Task ReopenTheWindowsOpenLastTimeAsync()
    {
        string[]? ids;
        try
        {
            _windowsModule = await JS.InvokeAsync<IJSObjectReference?>("import", DrawioWindow.ModulePath);
            ids = _windowsModule is null ? null : await _windowsModule.InvokeAsync<string[]?>("openedLastTime");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // A convenience only: nothing opens again, and nothing is remembered from here on.
            _windowsModule = null;
            return;
        }

        var reopened = false;
        foreach (var (section, id) in WindowIds)
        {
            if (ids?.Contains(id) == true && _openSections.Add(section)) reopened = true;
        }

        // OnAfterRenderAsync does not render again by itself once it returns.
        if (reopened) StateHasChanged();
    }

    /// <summary>The windows open now, remembered for the next visit in this browser - by the module, in the order they are stacked.</summary>
    private async Task RememberOpenWindowsAsync()
    {
        // The module is imported only after the bridge attach (ReopenTheWindowsOpenLastTimeAsync): a window toggled before that is not remembered until the next toggle.
        if (_windowsModule is null) return;
        try
        {
            string[] open = [.. WindowIds.Where(window => IsOpen(window.Section)).Select(window => window.Id)];
            await _windowsModule.InvokeVoidAsync("rememberOpen", new object?[] { open });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Not remembered for next time: the windows in front of the operator are unaffected.
        }
    }

    /// <summary>What the drawing answered to a row of one of the lists, and the cell that row asked it to select.</summary>
    private sealed record DrawioGoTo(string CellId, DrawioSaid Outcome);

    private DrawioGoTo? _deviceListGoTo;

    private DrawioGoTo? _junctionListGoTo;

    private DrawioGoTo? _missionListGoTo;

    /// <summary>
    /// Row 60 (compito 3): a row of the missions list chosen - the device the mission is on selected
    /// on the drawing, the same selection as the device list's. A mission on no device selects nothing,
    /// and says so.
