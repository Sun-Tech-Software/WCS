    /// <summary>
    /// The sections of the bar above the drawing (the plant's file, Operations, the three lists, the
    /// PLC connections, and since the passata grafica the plant checks), each in a floating window of
    /// its own.
    /// </summary>
    private enum DrawioSection
    {
        PlantFile,
        Operations,
        Devices,
        Junctions,
        Missions,
        PlcConnections,
        Checks,
    }

    /// <summary>
    /// The sections whose window is open (spec 2026-09-29): any number at a time, since a window
    /// floats over the canvas and takes no height from the drawing - the old "one section open at a
    /// time" rule existed only because an open section did.
    /// </summary>
    private readonly HashSet<DrawioSection> _openSections = [];

    private bool IsOpen(DrawioSection section) => _openSections.Contains(section);

    /// <summary>
    /// The button of the strip pressed: a shut window opens; an open one that is behind another comes
    /// to the front and stays open; the one in front of the open windows shuts (the owner's decision
    /// D1 of 29/9, and the spec's "opening a window already open behind others brings it to the
    /// front"). The others stay as they are.
    /// </summary>
    /// <remarks>
    /// Which window is in front is the windows module's to say - it keeps the order, the page does not
    /// - so the page asks it, for an open window only, and the module brings it to the front in the
    /// same call (<c>bringToFrontIfBehind</c>). Asked rather than left to the module to catch the
    /// click: open and shut stay the page's alone, as the rest of the page and its memory of the open
    /// windows rest on. Without the module (not loaded, or failing) the answer is "in front", and the
    /// button shuts the window, as it did before.
    /// </remarks>
    private async Task PressSectionButtonAsync(DrawioSection section)
    {
        if (IsOpen(section))
        {
            if (await BroughtToTheFrontAsync(section)) return;
            await CloseSectionAsync(section);
            return;
        }

        _openSections.Add(section);
        await RememberOpenWindowsAsync();
    }

    /// <summary>
    /// The window's X pressed, or Esc in it: the window shuts - and nothing at all happens if it is
    /// already shut, so that the second press of a fast double click on the X does not open it again.
    /// </summary>
    private async Task CloseSectionAsync(DrawioSection section)
    {
        if (!_openSections.Remove(section)) return;
        await RememberOpenWindowsAsync();
    }

    /// <summary>Whether the windows module brought this section's open window to the front because it was behind another (see <see cref="PressSectionButtonAsync"/>).</summary>
    private async Task<bool> BroughtToTheFrontAsync(DrawioSection section)
    {
        if (_windowsModule is null) return false;
        try
        {
            return await _windowsModule.InvokeAsync<bool>("bringToFrontIfBehind", WindowIdOf(section));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // The order cannot be asked: the button does what it did before the order was asked.
            return false;
        }
    }

    private static string WindowIdOf(DrawioSection section) => WindowIds.First(window => window.Section == section).Id;

    /// <summary>
    /// Where each window opens when this browser remembers nothing about it: a cascade in the order of
    /// the strip, the lists wider than the two sections of commands (the device list has a column for
    /// every field of the configuration). The plant checks are seventh: their button comes before the
    /// six in the bar, but they joined the windows last, and the six keep their places. They are also
    /// the smallest (owner's decision, 30/9): at rest what they hold - one row of two buttons - needs a
    /// window about 90 px high, about 180 with a few results; at 640 x 440 it was mostly empty. Opened
    /// with Devices they still cover some of its rows, which the owner accepted.
    /// </summary>
    private static readonly IReadOnlyDictionary<DrawioSection, DrawioWindowPlace> WindowPlaces =
        new Dictionary<DrawioSection, DrawioWindowPlace>
        {
            [DrawioSection.PlantFile] = DrawioWindowPlace.Cascade(0, 680, 320),
            [DrawioSection.Operations] = DrawioWindowPlace.Cascade(1, 560, 320),
            [DrawioSection.Devices] = DrawioWindowPlace.Cascade(2, 760, 440),
            [DrawioSection.Junctions] = DrawioWindowPlace.Cascade(3, 640, 400),
            [DrawioSection.Missions] = DrawioWindowPlace.Cascade(4, 1020, 620),
            [DrawioSection.PlcConnections] = DrawioWindowPlace.Cascade(5, 980, 560),
            [DrawioSection.Checks] = DrawioWindowPlace.Cascade(6, 480, 220),
        };

    private static readonly DrawioWindowPlace MissionStepsWindowPlace = new(210, 210, 920, 480);
    private static readonly DrawioWindowPlace LinkedCellsWindowPlace = new(242, 242, 720, 520);

    /// <summary>The device each contextual information window is pinned to; null means shut.</summary>
    private Guid? _missionStepsWindowItemId;
    private Guid? _linkedCellsWindowItemId;

