    private async Task GoToFromMissionListAsync(MissionDto mission)
    {
        if (mission.PositionItemId is not { } itemId || itemId == Guid.Empty)
        {
            _missionListGoTo = new DrawioGoTo("", new DrawioSaid($"The mission {mission.MissionId} is on no device, so nothing was selected on the drawing."));
            return;
        }

        var cellId = DrawnCellOf(itemId);
        var (_, outcome) = await SelectDeviceOnTheDrawingAsync(itemId);
        _missionListGoTo = new DrawioGoTo(cellId, outcome);
    }

    /// <summary>
    /// A list's "go to" line is about ONE cell of the drawing: once the selection is anything else,
    /// "X is selected in the drawing" is no longer true (and "nothing was selected" is behind the
    /// operator), so the line goes. It stays while the selection is that cell - which is also how the
    /// selection the row itself caused arrives, before or after draw.io's answer.
    /// </summary>
    private void ForgetGoTosTheSelectionMadeUntrue(IReadOnlyList<string>? cellIds)
    {
        if (_deviceListGoTo is { } device && !IsOnly(cellIds, device.CellId)) _deviceListGoTo = null;
        if (_junctionListGoTo is { } junction && !IsOnly(cellIds, junction.CellId)) _junctionListGoTo = null;
        if (_missionListGoTo is { } mission && !IsOnly(cellIds, mission.CellId)) _missionListGoTo = null;
    }

    private static bool IsOnly(IReadOnlyList<string>? cellIds, string cellId) => cellIds is [var only] && only == cellId;

    /// <summary>
    /// Asks the drawing to select one cell and bring it into view (the bridge's <c>selectCell</c>):
    /// its answer, or - when there was none - why, as <paramref name="failure"/>'s words, with what the
    /// page's script threw behind the line's "?" (row 37 of the queue, extended to the whole page on
    /// 10/10). Shared by the devices (the checks' "go to", the device list) and the junctions (the
    /// junction list).
    /// </summary>
    private async Task<(string? Answer, DrawioSaid? Failure)> AskTheDrawingToSelectAsync(string cellId)
    {
        if (_bridgeModule is null)
            return (null, new DrawioSaid("the drawing cannot be reached from this page (the bridge to draw.io did not load), so nothing was selected. Reload the page."));

        try
        {
            return (await _bridgeModule.InvokeAsync<string?>("selectCell", cellId), null);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            return (null, DrawioSaid.Failed(
                $"the drawing did not answer, because {DrawioFailureWords.WhyTheScriptDidNotAnswer(ex)}, so nothing was selected.", ex));
        }
    }

    /// <summary>
    /// The drawing asked to select one cell, and its answer worded - once, for a device and for a
    /// junction alike: <paramref name="named"/> is what the line is about, <paramref name="shape"/>
    /// what it is on the drawing ("cell", "arrow"), <paramref name="selected"/> what follows "is
    /// selected in the drawing and brought into view", <paramref name="noCell"/> the whole line for a
    /// subject with nothing drawn.
    /// </summary>
    private async Task<(bool Reached, DrawioSaid Outcome)> SelectOnTheDrawingAsync(string cellId, string named, string shape, string selected, string noCell)
    {
        var (answer, failure) = await AskTheDrawingToSelectAsync(cellId);
        if (failure is not null) return (false, failure with { Text = $"{named}: {failure.Text}" });

        return answer switch
        {
            "ok" => (true, new DrawioSaid($"{named} is selected in the drawing and brought into view{selected}.")),
            "no-cell" => (false, new DrawioSaid(noCell)),
            "no-graph" => (false, new DrawioSaid($"{named}: this page cannot reach the drawing's model - the same failure that stops it from following the selection - so nothing was selected. Reload the page.")),
            "failed" => (false, new DrawioSaid($"{named}: draw.io refused to select the {shape} (the browser console says why). Nothing was selected.")),
            _ => (false, new DrawioSaid($"{named}: the drawing answered something this page does not know how to read ({answer ?? "nothing at all"}), so it is NOT known whether the {shape} was selected.")),
        };
    }

    private Task<(bool Reached, DrawioSaid Outcome)> SelectDeviceOnTheDrawingAsync(Guid itemId)
    {
        var named = _graph?.Items.FirstOrDefault(item => item.ItemId == itemId) is { } device
            ? NameOf(device)
            : itemId.ToString();

        return SelectOnTheDrawingAsync(DrawnCellOf(itemId), named, "cell", ": its properties are in the column on the right",
            $"{named} has no cell in the drawing, so nothing was selected: a device with no position is not drawn at all, and neither is one whose shape was deleted from the canvas. The device is on the plant either way.");
    }

    /// <summary>Row 59: a row of the junction list chosen - its arrow selected on the drawing.</summary>
    private async Task GoToJunctionAsync(Guid junctionId)
    {
        var named = _graph?.Junctions.FirstOrDefault(junction => junction.JunctionId == junctionId) is { } junction
            ? $"The junction {NameOfItem(junction.SourceItemId)} -> {NameOfItem(junction.DestinationItemId)}"
            : $"The junction {junctionId}";

        var edgeId = DrawnEdgeOf(junctionId);
        var (_, outcome) = await SelectOnTheDrawingAsync(edgeId, named, "arrow", "",
            $"{named} has no arrow in the drawing, so nothing was selected: a junction is drawn only between two drawn devices, and not at all once its arrow was deleted from the canvas. The junction is on the plant either way.");
        _junctionListGoTo = new DrawioGoTo(edgeId, outcome);
    }

    /// <summary>
    /// The drawn arrow of a junction: the one the save mapped to it (an arrow drawn by hand keeps
    /// draw.io's own id), otherwise the junction's own id, which is what the seeding gives an arrow -
    /// the twin of <see cref="DrawnCellOf"/> for devices.
    /// </summary>
    private string DrawnEdgeOf(Guid junctionId)
    {
        foreach (var (edgeId, mapped) in _plantJunctionByDrawnEdge)
            if (mapped == junctionId) return edgeId;
        return junctionId.ToString();
    }

    /// <summary>The junction whose arrow is the one cell selected on the drawing, if that is what is selected: its row of the junction list is marked.</summary>
    private Guid? SelectedJunctionId
    {
        get
        {
            if (SelectionState.SelectedCellIds is not [var cellId] || _graph is not { } graph) return null;
            if (_plantJunctionByDrawnEdge.TryGetValue(cellId, out var mapped)) return mapped;
            return Guid.TryParse(cellId, out var id) && graph.Junctions.Any(junction => junction.JunctionId == id) ? id : null;
        }
    }

    private string NameOfItem(Guid itemId) =>
        _graph?.Items.FirstOrDefault(item => item.ItemId == itemId) is { } device ? NameOf(device) : itemId.ToString();

    private async Task OnKeyAcceptedAsync() => await LoadGraphAsync();

    protected override async Task OnInitializedAsync()
    {
        _geometry = new DrawioGeometryCoordinator(
            State,
            _plantJunctionByDrawnEdge,
            () => _decorationLoaded,
            () => _decorationFailure,
            xml => _decorationXml = xml,
            denied => _lockDenied = denied, TakeOffTheCanvasAsync);
        _save = new DrawioSaveCoordinator(
            _geometry,
            _writeGate,
            () => _graph,
            graph =>
            {
                if (_graph is { } page)
                    page.Adopt(graph);
                else
                    _graph = graph;
            },
            State,
            () => _documentSent,
            _plantJunctionByDrawnEdge,
            _plantItemByDrawnCell,
            EnsureWritableAsync);
        _save.Changed += OnCoordinatorChanged;
        _selection = new DrawioSelectionCoordinator(
            State,
            _writeGate,
            () => _graph,
            _plantItemByDrawnCell,
            ReadMarkedCellsAsync,
            RenameCellAsync,
            EnsureWritableAsync,
            () => _navStatus);
        _selection.Changed += OnCoordinatorChanged;
        _creation = new DrawioCreationCoordinator(
            State,
            _writeGate,
            () => _graph,
            _plantItemByDrawnCell,
            () => NewDevicesWritableAsync("created"),
            CanvasTakesTheNameAsync,
            _selection.RefreshSelectedConfigAsync);
        _creation.Changed += OnCoordinatorChanged;
        _duplication = new DrawioDuplicationCoordinator(State, _writeGate, () => _graph, () => NewDevicesWritableAsync("duplicated"), SourceOnTheCanvasAsync, DrawTheDuplicateAsync);
        _duplication.Changed += OnCoordinatorChanged;
        // The engine switch reads the status the page SHOWS: "already stopped" and "already
        // reached" are said about what the operator sees, which is the newest status known.
        // Without a Live feed the page reads the status by itself while a command is pending: the
        // same GET as before a write, which shows what it reads when the feed is not Live.
        _engine = new DrawioEngineCoordinator(_writeGate, () => State.Client, EnsureEngineCanStartAsync, UnsavedWorkAsync,
            ReleaseStartPermitAsync, () => DisplayedNavStatus, RefreshEngineStatusAsync, () => _live?.Connection == LiveConnection.Live,
            _gone.Token, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30));
        _engine.Changed += OnCoordinatorChanged;
        _writeGate.Changed += OnWriteGateChanged;
        _routes = new LiveRouteReader(() => State.Client, () => _graph);
        State.ConnectionCameBack += OnConnectionCameBack;

        if (State.HasKey) await LoadGraphAsync();
    }

    private void OnWriteGateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });
    }

    private void OnCoordinatorChanged() => OnWriteGateChanged();

    private async Task LoadGraphAsync()
    {
        var graph = new PlantGraph();
        await graph.LoadAsync(State.Client);
        _graph = graph;

        await LoadDecorationAsync();
        await RefreshEngineStatusAsync();

        await SendLibraryAsync();
        await SeedDrawioAsync();

        // Last and not awaited: the drawing never waits for the live channel. draw.io starts only
        // once the library is sent, and a channel slow to open - or not opening at all - would have
        // kept the plant off the canvas, and this page on "Loading the plant...", for as long.
        // StartLiveAsync throws nothing: whatever fails in it is said on the page, not dropped with
        // the discarded task.
        _ = StartLiveAsync();
    }

    private async Task LoadDecorationAsync()
    {
        try
        {
            _decorationXml = await State.Client.GetPlantDecorationAsync();
            _decorationLoaded = true;
            _decorationFailure = null;
            _decorationNotice = null;
            return;
        }
        catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException)
        {
            _decorationXml = null;
            _decorationLoaded = false;
            _decorationFailure = ex;
        }

        // One sentence with the why in the page's words, and the host's answer behind its "?" (row 37
        // of the queue, extended to the whole page on 10/10).
        _decorationNotice = DrawioSaid.Failed(
            $"Decoration: the plant's decoration could not be read because {DrawioFailureWords.Why(_decorationFailure)}: the drawing starts without it, and so as not to erase it, it will not be rewritten for this whole session. " +
            "To try again, reload the page NOW - before you draw, while reloading costs nothing.",
            _decorationFailure);
    }

    private async Task RefreshEngineStatusAsync()
    {
        var asked = _navSequence;
        NavigatorStatusTypes read;
        try
        {
            read = (await State.Client.GetStatusAsync()).NavStatus;
        }
        catch (Exception ex) when (ex is HttpRequestException or WcsApiException or TaskCanceledException)
        {
            // Not known for the write decision; for the display, a read that failed says nothing
            // about the engine, and what is shown stays the last thing known.
            _navStatus = null;
            return;
        }

        _navStatus = read;
        // Shown only if it is the newest thing known: nothing was shown since this read started,
        // and the feed is not Live - while it is, the host tells every change on the channel, and a
        // GET that lands after a live event is the older of the two.
        if (_navSequence == asked && _live?.Connection != LiveConnection.Live)
            await ShowNavStatusAsync(read);
    }

    /// <summary>Shows <paramref name="status"/> as the engine's, and sends the hover once more if it has not gone through yet.</summary>
    private async Task ShowNavStatusAsync(NavigatorStatusTypes status)
    {
        _navSequence++;
        if (_shownNavStatus == status) return;
        _shownNavStatus = status;
        _engine.EngineStatusArrived(status);
        ForgetTheMenuCommandUnlessRunning();
        StateHasChanged();
        await SendHoverAsync();
    }

    /// <summary>
    /// Opens this page's event channel. Its events come on the channel's threads: everything goes
    /// back to the circuit with InvokeAsync before touching the page.
    /// </summary>
    private async Task StartLiveAsync()
    {
        // A page disposed of while it was still loading must not open a channel nobody would close.
        if (_disposed || _live is not null) return;
        try
        {
            // Both can throw synchronously: State.Client and State.OpenEvents without a key, and a
            // channel that refuses its options.
            _live = new PlantLiveFeed(State.Client, State.OpenEvents(),
                itemId => _graph?.Items.FirstOrDefault(item => item.ItemId == itemId)?.DeviceType,
                // The host's own logging: a subscriber of the feed that throws is written down there.
                logger: FeedLogger);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // What was thrown, apart from the page's own sentence: behind the "?" of its line in the
            // row, and in the pill's tip under the sentence (row 37 of the queue, extended on 10/10).
            _liveUnavailable = DrawioFailureWords.Detail(ex);
            StateHasChanged();
            return;
        }

        _live.FrameReady += OnLiveFrameReady;
        _live.StatusChanged += OnLiveStatusChanged;
        _live.CommandChanged += OnLiveCommandChanged;
        await _live.StartAsync();
        await RunLiveAsync(OnLiveStatusChangedAsync);
    }

    private void OnLiveFrameReady() => OnLiveEvent(RefreshLiveAsync);

    private void OnLiveStatusChanged() => OnLiveEvent(OnLiveStatusChangedAsync);

    /// <summary>A command's outcome, for the engine switch: through the same guard as every live event.</summary>
    private void OnLiveCommandChanged(CommandDto command) => OnLiveEvent(() =>
    {
        _engine.CommandArrived(command);
        return Task.CompletedTask;
    });

    /// <summary>
    /// The one way the feed's events reach the page. It cannot throw back into the feed: FrameReady
    /// comes on a timer thread of the process that also runs the engine. And it may come after this
    /// page is gone - the feed can raise one just after its DisposeAsync has returned.
    /// </summary>
    private void OnLiveEvent(Func<Task> work)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() => RunLiveAsync(work));
        }
        catch (ObjectDisposedException)
        {
            // The circuit's renderer is already torn down: there is no page left to update.
        }
    }

    /// <summary>
    /// Runs a piece of the live path on the circuit. Its task is discarded by whoever raised the
    /// event, so an exception left in it would go nowhere: it is caught here and said on the page.
    /// </summary>
    private async Task RunLiveAsync(Func<Task> work)
    {
        if (_disposed) return;
        try
        {
            await work();
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            if (_disposed) return;
            _liveFailure = DrawioSaid.Failed(
                "Part of the live status stopped working on this page: the drawing and the save work as before.", ex);
            _liveFailedIn = work;
            TryStateHasChanged();
            return;
        }

        // The same piece went through this time: what it had said is no longer true.
        if (_liveFailedIn is not null && _liveFailedIn.Equals(work))
        {
            _liveFailure = null;
            _liveFailedIn = null;
            TryStateHasChanged();
        }
    }

    private void TryStateHasChanged()
    {
        if (_disposed) return;
        try
        {
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // The renderer went away in the meantime: there is no page left to tell.
        }
    }

    private async Task OnLiveStatusChangedAsync()
    {
        if (_disposed || _live is null) return;
        // The feed's word is the newest: every change it applies here counts as the last thing known,
        // also while it is Interrupted - then its status is the last one it received.
        if (_live.NavStatus is { } status)
        {
            _navSequence++;
            _shownNavStatus = status;
            _engine.EngineStatusArrived(status);
            ForgetTheMenuCommandUnlessRunning();
        }

        // StateHasChanged first: the banner must not wait for the live module to take the hover.
        StateHasChanged();
        await SendHoverAsync();
    }

    /// <summary>
    /// Queue item 21: a configuration write of this page that changed a load unit's size is on the
    /// canvas at once, not at the next live event - on an idle plant that could be never. The graph's
    /// own counter says whether the last frame was drawn with the sizes it holds now, and every render
    /// of the page asks it (OnAfterRenderAsync): ONE place for every way the sizes move - the
    /// properties panel, the device list, linking and unlinking a warehouse cell (each ends in a
    /// render of the page), the mode switch's and the save's rereads of the plant, which read the
    /// sizes again without seeding the drawing. An import reloads the page, and the seeding sends the
    /// whole frame. Comparing two integers costs nothing on the renders that change nothing.
    /// </summary>
    private async Task RedrawLiveIfLoadUnitSizesMovedAsync()
    {
        if (_graph is { } graph && graph.LoadUnitSizesRevision != _liveLoadUnitSizesRevision) await RefreshLiveAsync();
    }

    /// <summary>The graph's <see cref="PlantGraph.LoadUnitSizesRevision"/> the last frame sent to the canvas was built with.</summary>
    private int? _liveLoadUnitSizesRevision;

    /// <summary>Sends the whole live frame to the canvas; the module draws only what changed.</summary>
    private async Task RefreshLiveAsync()
    {
        if (_disposed || _live is null || _liveModule is null || !_documentSent || _graph is not { } graph) return;
        string? answer;
        string? reason = null;
        try
        {
            // Taken BEFORE the frame is built: a write landing while this frame is on its way moves
            // the counter past it, and the next check sends another.
            _liveLoadUnitSizesRevision = graph.LoadUnitSizesRevision;
            answer = await _liveModule.InvokeAsync<string?>("render", LiveFrameJson.Build(_live.TakeFrame(), DrawnCellOf, graph.LoadUnitSizeOf));
        }
        catch (JSException)
        {
            // The browser's own failure: its console has it.
            answer = "failed";
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // Not only the JS failures: a frame that cannot be built, or an answer that cannot be
            // read, is the same fact for the page - the live status is not on the canvas. This method
            // is also called straight from the seeding, where an exception would fail OnDrawioReady.
            // The browser console knows nothing of these: the reason goes on the line.
            answer = "failed";
            reason = DrawioFailureWords.Detail(ex);
        }

        // 'no-graph' before draw.io's init is not a failure: the next frame after the seeding draws.
        var failed = answer == "failed" || (answer == "no-graph" && SelectionState.SelectionUnavailable);
        if (failed != _liveDrawFailed || (failed && reason != _liveDrawReason))
        {
            _liveDrawFailed = failed;
            _liveDrawReason = failed ? reason : null;
            StateHasChanged();
        }

        // A hover that did not go through is sent again at every frame until it does: besides a change
        // of the engine's status, which may not come for as long as the engine stays put, nothing else
        // would give it another chance.
        if (!_hoverSent) await SendHoverAsync();

        // Row 63: a device that goes offline or back is offered "Set Ready"/"Set Off Line" in the
        // right-click menu from this frame on - selected or not, which is why it is not left to the
        // render below, made only for the selected device.
        await SyncDeviceMenuAsync();

        // StatusOf is read at DeviceCommands' render time, not stored: without a render here, "Set
        // Ready"/"Set Off Line" (and the panel's Status parameter generally) would stay whatever it
        // was on the last selection or configuration change, one live frame behind the device - and
        // so would the load unit in the panel's heading (SelectedLoadUnit, read the same way).
        // Guarded by an actual change: a frame that carries every OTHER device's movement, and
        // leaves the SELECTED one's status and load unit exactly as last rendered, does not deserve a
        // render here - a status change, a load unit taken or left, or another device's selection each
        // still show up, because each changes the (ItemId, Status, LoadUnit) triple being compared.
        if (SelectionState.ConfigItemId is { } selectedItemId)
        {
            var current = (selectedItemId, _live?.StatusOf(selectedItemId)?.Status, SelectedLoadUnit);
            if (_lastRenderedDeviceStatus != current)
            {
                _lastRenderedDeviceStatus = current;
                TryStateHasChanged();
            }
        }
    }

    /// <summary>
    /// The hover route is on whatever the engine's state: it only READS the route (two GETs at every
    /// entry into a device), and a route is there to be seen also with the engine stopped - the
    /// operator's change of destination builds it at once (owner's decision 3 of 30/9, missions plan;
    /// until then it was on only with the engine running, spec row 53). So it is switched on once,
    /// when the live module and the page's reference are there, and never off: the module's own
    /// clear() takes it away with the page. One send at a time; a send that fails leaves it unknown,
    /// and RefreshLiveAsync sends again at every frame until one goes through.
    /// </summary>
    private async Task SendHoverAsync()
    {
        if (_hoverSending || _hoverSent) return;
        _hoverSending = true;
        try
        {
            if (_disposed || _liveModule is null || _bridgeCallbackRef is null) return;
            try
            {
                await _liveModule.InvokeVoidAsync("setHover", true, _bridgeCallbackRef);
            }
            catch (Exception ex) when (ex is not OutOfMemoryException)
            {
                SetHoverFailure(ex);
                return;
            }

            _hoverSent = true;
            SetHoverFailure(null);
        }
        finally
        {
            _hoverSending = false;
        }
    }

    /// <summary>The line of a hover that could not be switched on, or none once it went through. Honest about who can say why.</summary>
    private void SetHoverFailure(Exception? ex)
    {
        DrawioSaid? line = ex switch
        {
            null => null,
            JSException =>
                "The route on hover cannot be switched on on this canvas (the browser console says why): the colours, the drawing and the save work as before.",
            _ => DrawioSaid.Failed(
                "The route on hover cannot be switched on on this page: the colours, the drawing and the save work as before.", ex),
        };
        if (line == _hoverFailure) return;
        _hoverFailure = line;
        TryStateHasChanged();
    }

    [JSInvokable]
    public async Task OnLiveHover(string? cellId)
    {
        if (cellId is null || _selection.DeviceOf(cellId) is not { } device || _live is null)
        {
            _routes.Forget();
            return;
        }

        var loaded = _live.StatusOf(device.ItemId)?.LuLoadStatus == LuLoadStatusTypes.Loaded;
        if (await _routes.ReadAsync(device.ItemId, loaded) is not { } route || _liveModule is null) return;

        try
        {
            await _liveModule.InvokeVoidAsync("showRoute", cellId,
                route.Next is { } next ? DrawnCellOf(next) : null,
                route.Final is { } final ? DrawnCellOf(final) : null);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // A route that cannot be drawn is simply not drawn: the next hover asks again.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!State.HasKey) return;
        if (_bridgeAttachAttempted)
        {
            // Row 63: never before attach has gone out (see _bridgeAttached) - the rule the comment
            // in AttachTheBridgeAsync is about.
            await SyncDeviceMenuAsync();
            await RevealWhenThePanelIsReadyAsync();
            // Queue item 21: a load unit size written or read again is on the canvas at once.
            await RedrawLiveIfLoadUnitSizesMovedAsync();
            return;
        }

        await AttachTheBridgeAsync();

        // Once, like the attach, and after it: the attach is what the drawing waits for, the windows
        // are a convenience. Not at firstRender: the strip is on the page only once the key is.
        await ReopenTheWindowsOpenLastTimeAsync();
    }

    private async Task AttachTheBridgeAsync()
    {
        _bridgeAttachAttempted = true;

        // The live module FIRST, before the bridge's: from the moment _bridgeModule is set, nothing
        // may await until attach is called. LoadGraphAsync sends the configuration as soon as it has
        // the plant and _bridgeModule, and a configure that reaches the bridge before attach is lost:
        // attach makes the promise draw.io's 'configure' waits on, nobody resolves it, and draw.io
        // waits for ever on an empty canvas (measured in the browser suite, intermittent - it takes
        // the plant landing during that await; TheConfigurationNeverReachesTheBridgeBeforeAttach).
        // Importing it first costs nothing: it imports the bridge itself, so the import below finds
        // it already loaded.
        try
        {
            _liveModule = await JS.InvokeAsync<IJSObjectReference?>("import", LiveModulePath);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Without the live module the Editor still draws and saves: only the colours are missing.
            _liveModule = null;
            _liveDrawFailed = true;
            _liveDrawReason = ex is JSException ? null : DrawioFailureWords.Detail(ex);
        }

        try
        {
            _bridgeModule = await JS.InvokeAsync<IJSObjectReference?>("import", BridgeModulePath);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            SetBridgeUnavailable(BridgeNotLoadedMessage);
            return;
        }
        catch (OperationCanceledException)
        {
            SetBridgeUnavailable(BridgeTimedOutMessage);
            return;
        }

        if (_bridgeModule is null)
        {
            SetBridgeUnavailable(BridgeNotLoadedMessage);
            return;
        }

        _bridgeCallbackRef = DotNetObjectReference.Create(this);
        try
        {
            await _bridgeModule.InvokeVoidAsync("attach", _iframeElement, _bridgeCallbackRef, FrameUrl);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            SetBridgeUnavailable(BridgeNotRespondingMessage);
            return;
        }
        catch (OperationCanceledException)
        {
            SetBridgeUnavailable(BridgeTimedOutMessage);
            return;
        }

        _bridgeAttached = true;

        // Row 33, fix round 2: read AFTER attach, not before it. The comment above this method is
        // the whole reason - "from the moment _bridgeModule is set, nothing may await until attach
        // is called" - and this await broke exactly that rule: LoadGraphAsync runs concurrently
        // (started, not awaited, from OnInitializedAsync) and reaches SendLibraryAsync's own
        // "configure" call on this SAME _bridgeModule the instant it has the plant, which can land
        // inside this very await. attach() makes a FRESH promise for draw.io's 'configure' to wait
        // on; a configure sent before attach resolves the promise attach has not made yet, that
        // answer is thrown away, and draw.io waits forever on an empty canvas - MEASURED: a real run
        // of DrawioArrowByHandTest went red on exactly this, "the device never appeared on the
        // canvas ... within 60 seconds", after this await had been placed before attach. The switch
        // showing its remembered value a moment later than the canvas itself is a fair price for
        // that not happening again.
        await LoadRulerPreferenceAsync();

        await SendLibraryAsync();

        // Row 63: the renders that came while attach was on its way could not tell the bridge (see
        // _bridgeAttached), and a page whose plant is already loaded may not render again for a long
        // time - an untouched page does not. Said here, once, for them.
        await SyncDeviceMenuAsync();
    }

    private async Task SendLibraryAsync()
    {
        if (_bridgeModule is null || _graph is not { } graph || _librarySent) return;
        _librarySent = true;

        try
        {
            await _bridgeModule.InvokeVoidAsync("configure", DrawioLibrary.Build(graph.Types));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            SetBridgeUnavailable(LibraryNotSentMessage);
        }
    }

    private void SetBridgeUnavailable(string message)
    {
        _bridgeUnavailable = true;
        _bridgeUnavailableMessage = message;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDrawioReady()
    {
        _drawioReady = true;
        await SeedDrawioAsync();
        await RunLiveAsync(SendHoverAsync);
        // Row 33: "if at startup the memory says on, they turn on as soon as draw.io is ready" - this
        // IS that moment, but the call is UNCONDITIONAL and not only "if (_rulersOn)". Fix round 1:
        // draw.io builds its OWN ruler at its OWN startup, before this method ever runs - MEASURED in
        // app.min.js, EditorUi's constructor reads mxSettings.isRulerOn() (draw.io's shared
        // ".drawio-config" localStorage entry, the very one setRulerVisible's own mxSettings.save()
        // writes into) and creates the mxDualRuler right there if it says on. A stale "on" left in
        // that shared entry - by an earlier session, or by this very bundle's own last save - would
        // otherwise show rulers on a canvas this page believes are off, with no way back: the old
        // "if" only ever asked draw.io to turn rulers ON, never to turn an unwanted ON back off.
        // setRulerVisible is cheap when nothing has to change - it asks isRulerVisible() first - so
        // reconciling every time costs nothing in the ordinary case where the two already agree.
        await SetRulerVisibleAsync(_rulersOn);
    }

    /// <summary>Row 33: the switch's remembered value, read off the browser's own storage through the bridge.</summary>
    private async Task LoadRulerPreferenceAsync()
    {
        if (_bridgeModule is null) return;
        try
        {
            _rulersOn = await _bridgeModule.InvokeAsync<bool>("loadRulerPreference");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Row 33's own rule: without memory the page works the same, with the default (off).
            _rulersOn = false;
        }

        // OnAfterRenderAsync does not render again by itself once it returns: without this the
        // switch would go on showing the false it was first rendered with, even after _rulersOn
        // just became true above.
        StateHasChanged();

        // THE RACE: OnDrawioReady can run its own reconciliation (setRulerVisible(_rulersOn), see
        // there) BEFORE this await above returns - draw.io's 'init' is not ordered against this
        // call. When that happens the canvas was reconciled with the false this field still held,
        // and _rulersOn changing above never reaches the canvas: the switch shows on, the rulers
        // stay off. _drawioReady already true is exactly that signal, and it is safe to reconcile
        // again here - setRulerVisible is cheap when nothing has to change (it asks isRulerVisible()
        // first, see there).
        if (_drawioReady) await SetRulerVisibleAsync(_rulersOn);
    }

    /// <summary>
    /// The operator flipped the switch: shown at once (the switch is the operator's own gesture, it
    /// must not wait for draw.io to answer), then applied to the canvas and remembered for next time -
    /// two separate calls, because one failing must not stop the other: a ruler that could not be
    /// toggled is still worth remembering for the next reload, and a preference that could not be
    /// saved must not leave the canvas showing the old state.
    /// </summary>
    private async Task OnRulerToggleAsync(bool enabled)
    {
        _rulersOn = enabled;
        StateHasChanged();
        await SetRulerVisibleAsync(enabled);
        await SaveRulerPreferenceAsync(enabled);
    }

    private async Task SetRulerVisibleAsync(bool enabled)
    {
        if (_bridgeModule is null) return;
        try
        {
            await _bridgeModule.InvokeVoidAsync("setRulerVisible", enabled);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // The switch still shows what the operator asked for; only the canvas did not follow.
            // Nothing else to do from here - the bridge's own console line says why, as everywhere
            // else in this file.
        }
    }

    private async Task SaveRulerPreferenceAsync(bool enabled)
    {
        if (_bridgeModule is null) return;
        try
        {
            await _bridgeModule.InvokeVoidAsync("saveRulerPreference", enabled);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Not remembered for next time: the session in front of the operator is unaffected.
        }
    }

    /// <summary>
    /// Row 8, the owner's decision of 27/9: draw.io was asked to cut a selection holding devices of
    /// the plant, and the bridge did nothing (drawio-bridge.js, guardTheCut). Said here, on the page,
    /// until the selection moves.
    /// </summary>
    [JSInvokable]
    public void OnDrawioCutRefused(string[]? cellIds)
    {
        var ids = cellIds ?? [];
        var devices = ids.Select(id => _selection.DeviceOf(id)).ToList();
        var names = ids.Select((id, i) => devices[i] is { } device ? NameOf(device) : id).ToList();
        // The bridge refuses a cell the page knows as a device AND a cell that only carries the device
        // mark (a refused drop, an orphan): the second is not "a plant device", and is not worded as one.
        var what = devices.Count > 0 && devices.All(device => device is not null)
            ? "A plant device cannot be cut: drag it to move it, or delete it with Delete."
            : "A device shape cannot be cut: it is marked as a device, and the plant does not know it - delete it with Delete, or point it at a device from the properties column.";
        _cutRefused = $"{what} Nothing was cut ({(names.Count == 0 ? "the selection holds a device" : string.Join(", ", names))}).";
        _cutRefusals++;
        TryStateHasChanged();
    }

    /// <summary>The line of <see cref="OnDrawioCutRefused"/>, null when there is nothing to say.</summary>
    private string? _cutRefused;

    /// <summary>
    /// How many cuts were refused: each one is a new outcome in the row under the bar, so a second
    /// Ctrl+X on the same selection shows its line again after the X closed the first.
    /// </summary>
    private long _cutRefusals;

    [JSInvokable]
    public Task OnDrawioSelectionChanged(string[]? cellIds)
    {
        _cutRefused = null;
        ForgetGoTosTheSelectionMadeUntrue(cellIds);
        ForgetTheMenuEntryTheSelectionMadeUntrue(cellIds);
        return _selection.SelectionChangedAsync(cellIds ?? []);
    }

    [JSInvokable]
    public void OnDrawioSelectionUnavailable()
    {
        ForgetGoTosTheSelectionMadeUntrue(null);
        ForgetTheMenuEntryTheSelectionMadeUntrue(null);
        _selection.SelectionUnavailable();
    }

    /// <summary>
    /// Queue item 15: draw.io selected <paramref name="count"/> cells, too many for their identifiers to
    /// cross the circuit in one message (drawio-bridge.js, tellOrWarn): the bridge sent their count
    /// instead. What depended on the selection is let go as for any selection that moved, and the
    /// panel's line says it.
    /// </summary>
    [JSInvokable]
    public Task OnDrawioTooManyCellsSelected(int count)
    {
        _cutRefused = null;
