@* The icons of the draw.io page (passata grafica, 2026-09-29): nineteen small drawings of our own,
   one per name, on a 16 x 16 grid - no icon set, no package, no file to fetch. They are
   decorative (aria-hidden): the button, pill or header around an icon carries the words, and an
   icon never replaces them for a screen reader. Stroke and fill are "currentColor", so an icon takes
   the colour of the text around it in every state - a pill's tone, a pressed button's white.
   A name with no drawing throws: a button whose icon was misspelt must break in a test, not show an
   empty square. The name is on the drawing too (data-icon): which icon a control shows is part of
   what it says, and the tests read it there. *@

<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="drawio-icon" data-icon="@Name">
    @Drawing
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private RenderFragment Drawing => Name switch
    {
        // A sheet with its top right corner folded.
        "plant-file" => @<g><path d="M3.75 1.75h5.5l3 3v9.5h-8.5z" /><path d="M9.25 1.75v3h3" /></g>,
        // An open-end wrench: the head at the top right with its jaws open, the handle to the bottom left.
        "operations" => @<g><path d="M10.99 2.25A3.4 3.4 0 0 0 7.32 7.04L2.45 11.85a1.2 1.2 0 0 0 1.7 1.7L8.96 8.68A3.4 3.4 0 0 0 13.75 5.01L12.19 6.57 9.43 3.81z" /></g>,
        // A list: three rows, each with its bullet.
        "devices" => @<g><circle cx="3" cy="4" r=".75" fill="currentColor" /><circle cx="3" cy="8" r=".75" fill="currentColor" /><circle cx="3" cy="12" r=".75" fill="currentColor" /><path d="M6.25 4h7.5M6.25 8h7.5M6.25 12h7.5" /></g>,
        // Two devices and the arrow from one to the other, bent as draw.io draws a junction.
        "junctions" => @<g><rect x="1.75" y="1.75" width="4.5" height="4.5" rx="1" /><rect x="9.75" y="9.75" width="4.5" height="4.5" rx="1" /><path d="M6.25 4H12v4.25M10.5 6.75l1.5 1.5 1.5-1.5" /></g>,
        // A load unit - a box with its tape - and the arrow it travels along.
        "missions" => @<g><rect x="1.75" y="5.75" width="7.5" height="7.5" rx="1" /><path d="M5.5 5.75v3" /><path d="M9.75 3.25h4.5M12.25 1.25l2 2-2 2" /></g>,
        // Two storage cells joined by a short chain: a device linked to warehouse storage.
        "linked-cells" => @<g><rect x="1.5" y="2.25" width="5" height="4.5" rx="1" /><rect x="9.5" y="9.25" width="5" height="4.5" rx="1" /><path d="M5.25 9.75 9.75 5.25M4.25 11.25l-1.5 1.5M11.75 4.75l1.5-1.5" /></g>,
        // A plug: two pins, the body, the cable.
        "plc" => @<g><path d="M5.75 1.75v3M10.25 1.75v3" /><path d="M3.75 4.75h8.5v2.5a4.25 4.25 0 0 1-8.5 0z" /><path d="M8 11.5v2.75" /></g>,
        // A tick in a box.
        "checks" => @<g><rect x="1.75" y="1.75" width="12.5" height="12.5" rx="2" /><path d="M5 8.25l2 2 4-4.5" /></g>,
        // A ruler with its marks, long and short.
        "rulers" => @<g><rect x="1.25" y="5" width="13.5" height="6" rx="1" /><path d="M4 5v2.5M6.75 5V6.5M9.5 5v2.5M12.25 5V6.5" /></g>,
        // A question mark in a circle.
        "help" => @<g><circle cx="8" cy="8" r="6.25" /><path d="M6.25 6.25a1.75 1.75 0 1 1 3.5 0c0 1-1.75 1.25-1.75 2.25v.5" /><circle cx="8" cy="11.5" r=".5" fill="currentColor" /></g>,
        // A cross.
        "close" => @<g><path d="M4 4l8 8M12 4l-8 8" /></g>,
        // A funnel.
        "filter" => @<g><path d="M2 3h12L9.25 8.5v4.25l-2.5 1.25V8.5z" /></g>,
        // A magnifying glass: search inside the list's filter field.
        "search" => @<g><circle cx="6.75" cy="6.75" r="4.25" /><path d="m10 10 3.5 3.5" /></g>,
        // A triangle pointing right.
        "play" => @<g><path d="M4.75 2.75v10.5L13 8z" /></g>,
        // A square.
        "stop" => @<g><rect x="3.25" y="3.25" width="9.5" height="9.5" rx="1.5" /></g>,
        // Two bars side by side.
        "pause" => @<g><path d="M5.5 3.25v9.5M10.5 3.25v9.5" /></g>,
        // A small full dot: the pill around it gives it its colour.
        "live" => @<g><circle cx="8" cy="8" r="3.25" fill="currentColor" /></g>,
        // A padlock, shut.
        "lock" => @<g><rect x="3.25" y="7.25" width="9.5" height="7" rx="1.5" /><path d="M5.25 7.25V5a2.75 2.75 0 0 1 5.5 0v2.25" /></g>,
        // An arrow down into a tray: the plant taken out into a file.
        "export" => @<g><path d="M8 2v8M4.75 7.25 8 10.5l3.25-3.25" /><path d="M2.5 12v1.25a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1V12" /></g>,
        // An arrow up out of a tray: a file taken in as the plant.
        "import" => @<g><path d="M8 10.5V2.5M4.75 5.75 8 2.5l3.25 3.25" /><path d="M2.5 12v1.25a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1V12" /></g>,
        // An arrow leaving a box by its top right corner: "open the whole of it elsewhere".
        "details" => @<g><path d="M9.5 2.25h4.25V6.5M13.75 2.25l-6 6" /><path d="M12.25 9.5v3.25a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h3.25" /></g>,
        // Two browser surfaces with an arrow leaving the front one: move this live window out.
        "popout" => @<g><rect x="1.75" y="4.25" width="9" height="9" rx="1.25" /><path d="M6 2.25h7.75V10M13.75 2.25 7.5 8.5" /></g>,
        _ => throw new ArgumentException($"No icon named '{Name}'.", nameof(Name)),
    };
}
