    private void SetExtended(bool extended)
    {
        _extended = extended;
        if (!extended && SortKey is { } sortKey && !CompactColumnKeySet.Contains(sortKey)) ClearSort();
        _page = 1;
    }

    private void FilterMissionsTyped(ChangeEventArgs e)
    {
        FilterTyped(e);
        _page = 1;
    }

    private void SortMissionsBy(string key)
    {
        SortBy(key);
        _page = 1;
    }

    private static int PageCount(int rowCount) => DataGridPagination.PageCount(rowCount, PageSize);

    private void GoToPage(int page, int pageCount) => _page = Math.Clamp(page, 1, pageCount);

    private static string PageLine(int rowCount, int page) =>
        DataGridPagination.PageLine(rowCount, page, PageSize, "missions");

    private static IEnumerable<int> PageChoices(int currentPage, int pageCount) =>
        DataGridPagination.PageChoices(currentPage, pageCount);

    private void NormalizePage() => _page = Math.Min(_page, PageCount(VisibleRows().Count()));

    /// <summary>
    /// Reads every active mission. One read at a time: a reason to read again that arrives during
    /// one makes exactly one more after it (its answer may predate that reason). Never throws - it
    /// runs unobserved from OnParametersSet and from the channel's resync.
    /// </summary>
    private async Task ReadAsync()
    {
        if (_board.Reading)
        {
            _readAgain = true;
            return;
        }

        do
        {
            _readAgain = false;
            _stale = false;
            _board.BeginRead();
            _readError = null;
            try
            {
                var read = await Session.Client.GetMissionsAsync();
                if (_disposed) return;
                _board.ReadLanded(read);
                NormalizePage();
            }
            catch (Exception ex) when (ex is not OutOfMemoryException)
            {
                if (_disposed) return;
                _board.ReadFailed();
                var why = DrawioFailureWords.Why(ex);
                _readError = DrawioSaid.Failed(_board.HasRead
                    ? $"The missions could not be read again from the host because {why}: the rows below are how the host had them at the last read, with what the channel said since."
                    : $"The missions could not be read from the host because {why}.", ex);
            }
        }
        while (_readAgain && !_disposed);

        // A read that began after a change whose outcome is not known went through: the row says what
        // the host has now, and the next change can be asked.
        if (_readBeforeAsking is { } notKnown && _readError is null && _board.HasRead)
        {
            _readBeforeAsking = null;
            if (_outcome is { } outcome && outcome == notKnown.Outcome)
                _outcome = outcome with { Text = outcome.Text + ReadAgainLine(notKnown.Asked.MissionId) };
        }

        StateHasChanged();
    }

    /// <summary>The mission as the host has it after a read: where it is bound and through what, or that it is gone.</summary>
    private string ReadAgainLine(Guid missionId)
    {
        if (_board.Find(missionId) is not { } row) return " Read again: it is no longer active on the host.";
        var gateway = row.GatewayItemId is { } through && through != Guid.Empty ? $"passing through {DeviceName(through)}" : "with no gateway";
        return $" Read again: {BoundFor(row.DestinationItemId)}, {gateway}.";
    }

    /// <summary>The rows as filtered and sorted now: by the chosen column, otherwise by date and identifier - the order in which the missions came. Called once per render.</summary>
    /// <remarks>The filter looks at every field of the mission, the ones Compact does not show included - as it did before the two views, and as its placeholder says.</remarks>
    private IEnumerable<MissionDto> VisibleRows()
    {
        var rows = Filtered<MissionDto>(_board.Rows, ColumnKeys, (mission, key) => ColumnByKey[key].TextOf(mission, DeviceName));
        if (SortKey is not { } key || !ColumnByKey.TryGetValue(key, out var by))
            return rows.OrderBy(mission => mission.Date).ThenBy(mission => mission.MissionId);

        return Sorted(rows, mission => by.SortValue(mission, DeviceName), Comparer<object?>.Create(DrawioDtoColumn<MissionDto>.Compare))
            .ThenBy(mission => mission.Date).ThenBy(mission => mission.MissionId);
    }

    // ---- Names ------------------------------------------------------------------------------------

    private string DeviceName(Guid? itemId) =>
        itemId is not { } id || id == Guid.Empty ? "(no device)" : DeviceName(id);

    private string DeviceName(Guid itemId) =>
        Names().TryGetValue(itemId, out var item) ? NameOf(item) : $"{itemId} (not on the plant)";

    private static string NameOf(PlantItemDto item) => item.Name is { Length: > 0 } name ? name : item.ItemId.ToString();

    /// <summary>How a sentence names a mission: by its load unit when it has one, which is how an operator knows it.</summary>
    private static string MissionName(MissionDto mission) =>
        LoadUnitLabel(mission) is { } label ? $"the mission of load unit {label}" : $"the mission {mission.MissionId}";

    /// <summary>
    /// How the destination's sentences name a mission: its load unit bare, as the operator reads it on
    /// the label ("Send UC256355 to ..."); a mission without one by its identifier.
    /// </summary>
    private static string LoadUnitName(MissionDto mission) =>
        mission.LoadUnitCode is { Length: > 0 } code ? code
        : LoadUnitLabel(mission) is { } label ? $"load unit {label}"
        : $"the mission {mission.MissionId}";

    /// <summary>
    /// <see cref="LoadUnitName"/> at the start of a sentence: the words are capitalized, a load unit's
    /// code never - it is the identifier on the label, and "uc42" is not "Uc42".
    /// </summary>
    private static string LoadUnitFirst(MissionDto mission) =>
        mission.LoadUnitCode is { Length: > 0 } code ? code : Capitalized(LoadUnitName(mission));

    /// <summary>The load unit as a label: its code, or its number; null for a mission without one.</summary>
    private static string? LoadUnitLabel(MissionDto mission) =>
        mission.LoadUnitCode is { Length: > 0 } code ? code
        : mission.LoadUnitId != 0m ? mission.LoadUnitId.ToString("0.##", CultureInfo.InvariantCulture)
        : null;

    private string BoundFor(Guid? destination) =>
        destination is { } id && id != Guid.Empty ? $"bound for {DeviceName(id)}" : "with no destination";

    /// <summary>
    /// The change that waits for the end of the mission's step, said after the chosen mission (item 54,
    /// decision 4): empty when none waits.
    /// </summary>
    private string WaitingLine(MissionDto mission) => (mission.PendingChange, mission.PendingChangeItemId) switch
    {
        (MissionPendingChangeKind.Destination, { } to) => $" At the end of its movement it is sent to {DeviceName(to)}.",
        (MissionPendingChangeKind.Position, { } onto) => $" At the end of its movement it is moved onto {DeviceName(onto)}.",
        _ => "",
    };

    private static string Capitalized(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    /// <summary>The plant's devices by identifier, built again only when the plant moved: every device cell asks it.</summary>
    private Dictionary<Guid, PlantItemDto> Names()
    {
        if (Graph is not { } graph) return [];
        if (_names is null || !ReferenceEquals(_namesOf, graph) || _namesRevision != graph.Revision)
        {
            _names = graph.Items.GroupBy(item => item.ItemId).ToDictionary(group => group.Key, group => group.First());
            _namesOf = graph;
            _namesRevision = graph.Revision;
        }

        return _names;
    }

    private Dictionary<Guid, PlantItemDto>? _names;
    private PlantGraph? _namesOf;
    private int _namesRevision;

    // ---- Choosing and moving ----------------------------------------------------------------------

    /// <summary>A row chosen: the mission to move or to send elsewhere, and the device it is on selected on the drawing (by the page).</summary>
    private Task ChooseAsync(MissionDto mission)
    {
        if (_chosen != mission.MissionId)
        {
            _chosen = mission.MissionId;
            _pending = null;
            _pendingDestination = null;
            // The offer to clear the gateway was for the mission chosen before: it does not follow the row.
            _withoutTheGateway = null;
        }

        return OnSelect.InvokeAsync(mission);
    }

    /// <summary>
    /// The devices a target or a gateway can be picked from: the plant's, by name, those whose name holds
    /// what is typed in <paramref name="search"/> - and <paramref name="chosen"/>, always.
    /// </summary>
    private IEnumerable<PlantItemDto> Candidates(string search, Guid? chosen)
    {
        var devices = (Graph?.Items ?? []).OrderBy(NameOf, StringComparer.OrdinalIgnoreCase).ThenBy(item => item.ItemId);
        var wanted = search.Trim();
        return wanted.Length == 0
            ? devices
            : devices.Where(item => item.ItemId == chosen || NameOf(item).Contains(wanted, StringComparison.OrdinalIgnoreCase));
    }

    private void TargetPicked(ChangeEventArgs e) =>
        TargetIs(Guid.TryParse(e.Value as string, out var id) ? id : null);

    private void UseSelected()
    {
        if (SelectedItemId is { } id) TargetIs(id);
    }

    /// <summary>
    /// The target picked, from the list or from the drawing. The offer to clear the gateway is the
    /// refused change, frozen with its target: it ends when another target is picked, as it does when
    /// another row is chosen - its button names no target, and would send the one the page no longer
    /// shows (fix round 1).
    /// </summary>
    private void TargetIs(Guid? target)
    {
        _target = target;
        if (_withoutTheGateway is { } blocked && blocked.Asked.TargetId != target) _withoutTheGateway = null;
    }

    private bool CanMove(MissionDto? mission) =>
        mission is not null && _target is { } target && target != mission.PositionItemId && _sending is null;

    /// <summary>The first step of the two: the question names the mission, where it is and where it goes, frozen now.</summary>
    private void AskToMove(MissionDto? mission)
    {
        if (!CanMove(mission) || _target is not { } target) return;
        _pending = new PendingMove(mission!.MissionId, target, MissionName(mission), DeviceName(mission.PositionItemId), DeviceName(target));
    }

    /// <summary>
    /// The second step: the move asked of the host, and its answer told - see the file's own remarks.
    /// 400 and 409 are refusals before anything moved: the row stays as it is, and the host's words
    /// say why; so is the 503 of an engine still in Recover, told by its title, and the 503 of an engine
    /// not loaded, told by its field (row 34 of the queue), each with the page's own sentence. Anything
    /// else reads the list again, so the rows show where the host says the mission
    /// is.
    /// </summary>
    private async Task ConfirmMoveAsync()
    {
        if (_pending is not { } move || _sending is not null) return;
        _pending = null;
        _sending = "Asking the host to move the mission...";
        _outcome = null;
        _went = false;
        _withoutTheGateway = null;
        var readAgain = true;
        try
        {
            var applied = await Session.Client.SetMissionPositionAsync(move.MissionId, move.TargetId);
            _went = true;
            // Item 54, decision 4: with a step of the mission in flight the move waits for its end (202).
            _outcome = applied == MissionChangeApplied.AtTheEndOfTheMovement
                ? $"{Capitalized(move.Mission)} has a step under way: the move onto {move.Target} is applied at the end of the movement."
                : $"{Capitalized(move.Mission)} was moved onto {move.Target}: the host took it.";
        }
        catch (WcsApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _outcome = DrawioSaid.Failed($"{Capitalized(move.Mission)} was NOT moved: it is no longer active on the host (it ended or was removed).", ex);
        }
        catch (WcsApiException ex) when (ex.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Conflict)
        {
            readAgain = false;
            // What the status means on this route (MissionEndpoints, PUT .../position): a 400 is a
            // device the host does not know, a 409 the device occupied by another mission, its only
            // refusal: a step of the mission under way is no longer one, the move waits for its end
            // (202, item 54).
            var refusal = ex.StatusCode == HttpStatusCode.BadRequest
                ? $"the host does not know {move.Target} as a device"
                : $"the host refused it - {move.Target} carries another mission";
            _outcome = DrawioSaid.Failed($"{Capitalized(move.Mission)} was NOT moved onto {move.Target}: {refusal}. It is still on {move.From}.", ex);
        }
        catch (WcsApiException ex) when (ex.StatusCode == HttpStatusCode.ServiceUnavailable
                                         && Refusal.Of(ex.Body) is { Title: MissionMoveProblems.EngineRecoveringTitle })
        {
            // The engine is in Recover (owner's answer 4 of 8/10): a refusal before anything moved, told
            // by its title - the same 503 also comes with the engine not loaded, told by its field just
            // below, or without its database, which stays "not known".
            readAgain = false;
            _outcome = DrawioSaid.Failed($"{Capitalized(move.Mission)} was NOT moved onto {move.Target}. The engine is still loading the missions: try again in a moment.", ex);
        }
        catch (WcsApiException ex) when (ex.StatusCode == HttpStatusCode.ServiceUnavailable
                                         && DrawioSelectionCoordinator.UnavailableReason(ex.Body) == ServiceUnavailableProblems.EngineNotLoaded)
        {
            // The engine is not loaded (row 34 of the queue, told by the host's field): the host refused
            // the request before it reached the engine, so nothing moved; a list read again would get
            // the same 503.
            readAgain = false;
            _outcome = DrawioSaid.Failed($"{Capitalized(move.Mission)} was NOT moved onto {move.Target}: the engine is not ready (it is not loaded on the host). It is still on {move.From}.", ex);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // The failures after which the outcome is NOT known, the same for a move and for a change
            // of destination: no answer (transport, timeout), an answer this page does not expect, one
            // it cannot read, or the unforeseen, which must not leave the handler (it would end the
            // circuit). The request may have reached the host, so the list is read again. One sentence
            // with the why in the page's words, what came back behind its "?" (row 37 of the queue,
            // extended to the whole page on 10/10).
            _outcome = DrawioSaid.Failed(
                $"It is NOT known whether {move.Mission} was moved onto {move.Target}, because {DrawioFailureWords.Why(ex)}. The list is read again from the host.", ex);
        }
        finally
        {
            _sending = null;
        }

        if (readAgain && !_disposed) await ReadAsync();
    }

    // ---- Setting the destination ------------------------------------------------------------------

    /// <summary>
    /// Any device can be asked for, also where the load unit is: the host refuses that one in words
    /// ("already there"), and it alone knows whether a device is in the same group as the position.
    /// </summary>
    private bool CanSetDestination(MissionDto? mission) =>
        mission is not null && _target is not null && _sending is null && _readBeforeAsking is null;

    /// <summary>The first step of the two: the question and the gateway's choice, frozen now, with what there is kept.</summary>
    private void AskToSetDestination(MissionDto? mission)
    {
        if (!CanSetDestination(mission) || _target is not { } target) return;
        var currentId = mission!.DestinationItemId is { } destination && destination != Guid.Empty ? destination : (Guid?)null;
        var gatewayId = mission.GatewayItemId is { } through && through != Guid.Empty ? through : (Guid?)null;
        var isAWarehouse = IsAWarehouse(target);
        var isARelocator = IsARelocator(target);
        var (order, changeOfCell) = OrderOf(mission, target, isAWarehouse);
        var (cellOrder, cellChangeOfCell) = isARelocator ? OrderOf(mission, target, towardsAWarehouse: true) : (order, changeOfCell);
        _pendingDestination = new PendingDestination(mission.MissionId, target, LoadUnitName(mission), LoadUnitFirst(mission),
            mission.PositionItemId, DeviceName(mission.PositionItemId), DeviceName(target), isAWarehouse, currentId,
            currentId is { } current ? DeviceName(current) : null, gatewayId, gatewayId is { } gatewayNow ? DeviceName(gatewayNow) : null,
            currentId is { } bound && (bound == target || IsAMemberOf(bound, target)), mission.StorageDoorCode is { Length: > 0 },
            mission.OperatorDestination, order, changeOfCell, isARelocator, cellOrder, cellChangeOfCell);
        _gatewayChoice = GatewayChoice.Keep;
        _gateway = null;
        _gatewaySearch = "";
        _arrival = null;
        _cellChoice = CellChoice.ByTheWarehouse;
        _cellCode = "";
        _cellList = null;
    }

    /// <summary>
    /// A relocator, as the engine says it (MissionGateway.IsARelocator, item 54): a warehouse names it as
    /// its relocator (<see cref="PlantItemDto.RelocateItemId"/>) - a group too, when a warehouse names the
    /// group; a member of a relocating group is not one by itself.
    /// </summary>
    private bool IsARelocator(Guid itemId) =>
        (Graph?.Items ?? []).Any(storage => storage.DeviceType == DeviceTypes.Storage && storage.RelocateItemId == itemId);

    /// <summary>
    /// The engine treats as a warehouse a storage, and a group whose members include a storage
    /// (MissionGateway.StoragesOf): towards either it reserves a cell.
    /// </summary>
    private bool IsAWarehouse(Guid itemId)
    {
        if (!Names().TryGetValue(itemId, out var item)) return false;
        if (item.DeviceType == DeviceTypes.Storage) return true;
        return item is { DeviceType: DeviceTypes.GroupOfAutomationDevices, GroupItemId: not 0 }
               && (Graph?.Items ?? []).Any(member => member.BelongingGroupId == item.GroupItemId && member.DeviceType == DeviceTypes.Storage);
    }

    /// <summary>
    /// A storage member of the group <paramref name="groupId"/>: the destination the engine writes when a
    /// group of warehouses is chosen (it reserves in one of its members), so that group chosen again is
    /// the same warehouse again.
    /// </summary>
    private bool IsAMemberOf(Guid storageId, Guid groupId) =>
        Names().TryGetValue(groupId, out var group) && group is { DeviceType: DeviceTypes.GroupOfAutomationDevices, GroupItemId: not 0 }
        && Names().TryGetValue(storageId, out var member) && member.DeviceType == DeviceTypes.Storage
        && member.BelongingGroupId == group.GroupItemId;

    /// <summary>
    /// What a change towards a warehouse does to an extraction's order (answers 1 and 3 of 2/10, as
    /// MissionGateway.ChangeToStorageAsync and PathMission.CommitRoute do it): picked up already - it is
    /// on a device that is not a warehouse - it becomes a deposit, and the warehouse system, which
    /// counts the order as served since the pick-up, is told to reopen it through the engine's durable
    /// queue (item 45: PathMission.BecomeADepositOfAPickedExtraction), unless the order is already
    /// shipped or closed, which the log then says;
    /// still in its cell - on a warehouse, or nowhere with a warehouse as its source
    /// (PathMission.LoadUnitIsInItsStorageCell) - and sent to a warehouse its position does not reach
    /// (PathMission.Reaches: nowhere reaches nothing, so also its own warehouse), it becomes a change of
    /// cell. With an order to leave - an assignment, or a row of the extraction queue - the engine tells
    /// the warehouse system it leaves it, and closes the mission only if the change is refused after
    /// that (MissionGateway.LeaveTheExtractionAsync sets LeftTheExtraction): a refusal before it - no
    /// route to the door proposed, no cell, the cell's address not read, a step in flight - leaves the
    /// mission the extraction it was. Without one the warehouse system is told nothing and no refusal
    /// closes it. Null for any other change. <paramref name="towardsAWarehouse"/>: the change goes to a
    /// warehouse - the target is one, or (item 54, decision 6) a precise cell is chosen through the
    /// relocator that is the target.
    /// </summary>
    private (string? Order, bool ChangeOfCell) OrderOf(MissionDto mission, Guid target, bool towardsAWarehouse)
    {
        if (mission.MissionType != MissionTypes.Extraction || !towardsAWarehouse) return (null, false);
        var position = mission.PositionItemId is { } at && Names().TryGetValue(at, out var on) ? on : null;
        if (position is { DeviceType: not DeviceTypes.Storage })
            return ("It was picked up for an order: the warehouse system is told to reopen that order, and an order already shipped stays as it is.", false);

        // Only a target the position reaches is "already there" for the engine (PathMission.Reaches):
        // nowhere, with its own warehouse as the source, the load unit sent to that warehouse is a
        // change of cell like any other.
        var storage = position ?? (mission.SourceItemId is { } from && Names().TryGetValue(from, out var source)
                                   && source.DeviceType == DeviceTypes.Storage ? source : null);
        if (storage is null || Reaches(mission.PositionItemId, target)) return (null, false);
        var hasAnOrder = mission.AssignmentGuid is { } assignment && assignment != Guid.Empty || mission.ExtractionQueueId > 0;
        if (!hasAnOrder)
            return ($"It is still in its cell in {NameOf(storage)}: this makes it a change of cell. It has no order for the warehouse system to free.", true);
        return ($"It is still in its cell in {NameOf(storage)}: this makes it a change of cell, and its order goes back free in the warehouse system."
                + " If the change is refused after the warehouse system was told, the mission ends and the load unit stays in its cell.", true);
    }

    /// <summary>
    /// The engine's rule for "arrived" (PathMission.Reaches): <paramref name="target"/> is the
    /// position itself, or the group the position belongs to. Nowhere reaches nothing.
    /// </summary>
    private bool Reaches(Guid? position, Guid target)
    {
        if (position is not { } at || at == Guid.Empty || target == Guid.Empty) return false;
        if (at == target) return true;
        return Names().TryGetValue(at, out var device) && device.BelongingGroupId != 0
               && Names().TryGetValue(target, out var group) && group is { DeviceType: DeviceTypes.GroupOfAutomationDevices, GroupItemId: not 0 }
               && device.BelongingGroupId == group.GroupItemId;
    }

    /// <summary>
    /// The question as the gateway's radios leave it now: they may change the gateway, and towards the
    /// same warehouse that keeps the cell. A gateway picked that the load unit has already reached (its
    /// position, or the position's group) is no gateway for the engine (MissionGateway.ChangeDestinationAsync
    /// drops it): it is said as clearing the one there is, and as no change when there is none.
    /// </summary>
    private string QuestionOf(PendingDestination asked)
    {
        var clears = _gatewayChoice == GatewayChoice.Clear
                     || _gatewayChoice == GatewayChoice.Change && _gateway is { } reached && Reaches(asked.PositionId, reached);
        string? through = _gatewayChoice switch
        {
            _ when clears => asked.GatewayId is not null ? ", with no gateway" : null,
            GatewayChoice.Change when _gateway is { } picked && picked != asked.GatewayId => $", passing through {DeviceName(picked)}",
            _ => null,
        };
        if (PreciseCell(asked) is { } code) return asked.QuestionWithTheCell(code, through);
        var question = asked.QuestionWith(through);
        // Item 54, decision 5: what the relocator does, once the operator said it.
        return (asked.TargetIsRelocator ? _arrival : null) switch
        {
            MissionRelocatorArrival.Stay => $"{question} It stays at {asked.Target}: nothing else is done with it.",
            MissionRelocatorArrival.Deposit => $"{question} At {asked.Target} the warehouse system is asked for a cell {asked.Target} reaches, and {asked.Target} deposits it there.",
            _ => question,
        };
    }

    /// <summary>The cell can be chosen (item 54, decision 6): towards a warehouse, or towards a relocator that is to deposit it.</summary>
    private bool CellCanBeChosen(PendingDestination asked) =>
        asked.TargetIsStorage || asked.TargetIsRelocator && _arrival == MissionRelocatorArrival.Deposit;

    /// <summary>The precise cell's code as it goes to the host, trimmed; null when the cell is the warehouse system's to choose, or no code is written yet.</summary>
    private string? PreciseCell(PendingDestination asked) =>
        CellCanBeChosen(asked) && _cellChoice == CellChoice.Precise && _cellCode.Trim() is { Length: > 0 } code ? code : null;

    /// <summary>
    /// What the question still needs before it can be sent: the gateway to set when "change" is chosen,
    /// what the relocator does (item 54, decision 5), the cell's code when the operator chooses it (decision 6).
    /// </summary>
    private bool CanConfirmDestination(PendingDestination asked) =>
        !(_gatewayChoice == GatewayChoice.Change && _gateway is null)
        && !(asked.TargetIsRelocator && _arrival is null)
        && !(CellCanBeChosen(asked) && _cellChoice == CellChoice.Precise && PreciseCell(asked) is null);

    /// <summary>One choice of what the relocator does: a radio button with its label.</summary>
    private RenderFragment ArrivalOption(string value, string label, MissionRelocatorArrival choice) =>
        @<label class="drawio-mission-destination-option">
            <input type="radio" id="@($"drawio-mission-destination-relocator-{value}")" name="drawio-mission-destination-relocator"
                   value="@value" checked="@(_arrival == choice)" @onchange="() => _arrival = choice" />
            @label
        </label>;

    /// <summary>One choice of where the cell comes from: a radio button with its label. Choosing the operator's cell asks the warehouse system for the list.</summary>
    private RenderFragment CellOption(string value, string label, CellChoice choice) =>
        @<label class="drawio-mission-destination-option">
            <input type="radio" id="@($"drawio-mission-destination-cell-{value}")" name="drawio-mission-destination-cell"
                   value="@value" checked="@(_cellChoice == choice)" @onchange="() => CellChosenAsync(choice)" />
            @label
        </label>;

    /// <summary>
    /// The cell's choice changed: with the operator's cell, the warehouse system's list is read, once per
    /// question - again only after a failure. Never throws: it runs from a click.
    /// </summary>
    private async Task CellChosenAsync(CellChoice choice)
    {
        _cellChoice = choice;
        if (choice != CellChoice.Precise || _pendingDestination is not { } asked) return;
        if (_cellList is { Failure: null } list && list.MissionId == asked.MissionId && list.TargetId == asked.TargetId) return;

        var waiting = _cellList = new CellList(asked.MissionId, asked.TargetId, Loading: true, null, null);
        CellList answer;
        try
        {
            var cells = await Session.Client.GetMissionStorageCellsAsync(asked.MissionId, asked.TargetId);
            answer = waiting with { Loading = false, Cells = cells };
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            answer = waiting with { Loading = false, Failure = DrawioSaid.Failed(CellsNotListed(asked, ex), ex) };
        }

        // An answer for a question that is no longer open is dropped: another row, another target, or
        // the same question asked again, whose list is its own.
        if (_disposed || !ReferenceEquals(_cellList, waiting) || !ReferenceEquals(_pendingDestination, asked)) return;
        _cellList = answer;
    }

    /// <summary>Why the cells were not listed, in the page's words, from the problem's title and field; the host's own words are behind the line's "?".</summary>
    private static string CellsNotListed(PendingDestination asked, Exception ex)
    {
        const string write = " Write the cell's door A code to choose one.";
        if (ex is not WcsApiException api)
            return $"The cells could not be read from the host because {DrawioFailureWords.Why(ex)}.{write}";
        if (api.StatusCode == HttpStatusCode.NotFound)
            return $"The cells could not be listed: {asked.LoadUnit} is no longer active on the host (it ended or was removed).";
        switch (DrawioSelectionCoordinator.UnavailableReason(api.Body))
        {
            case ServiceUnavailableProblems.WarehouseUnreachable:
                return $"The cells could not be listed: the warehouse system does not answer.{write}";
            case ServiceUnavailableProblems.EngineNotLoaded:
                return $"The cells could not be listed: the engine is not ready (it is not loaded on the host).{write}";
        }

        var why = Refusal.Of(api.Body)?.Title switch
        {
            StorageCellCandidatesProblems.DeviceNotFoundTitle => $"the host does not know {asked.Target} as a device",
            StorageCellCandidatesProblems.NotAStorageTitle => $"{asked.Target} has no cells - it is not a warehouse, a group of warehouses or a relocator",
            StorageCellCandidatesProblems.NoStorageCellTitle => $"there is nothing to ask the warehouse system for this load unit in {asked.Target} (the host says why)",
            _ => null,
        };
        return why is null
            ? $"The cells could not be read from the host because {DrawioFailureWords.Why(ex)}.{write}"
            : $"The cells could not be listed: {why}.{write}";
    }

    /// <summary>The line over the list: how many cells the warehouse system proposes, or that it proposes none.</summary>
    private static string CellsLine(PendingDestination asked, int count) => count switch
    {
        0 => $"The warehouse system proposes no cell for {asked.LoadUnit} in {asked.Target}. Write the cell's door A code to choose one.",
        1 => $"The warehouse system proposes 1 cell for {asked.LoadUnit} in {asked.Target}, or write another one's door A code.",
        _ => $"The warehouse system proposes {count} cells for {asked.LoadUnit} in {asked.Target}, in its order, or write another one's door A code.",
    };

    /// <summary>A proposed cell as the list names it: its door A code, where it is, and how full it is.</summary>
    private static string CellName(StorageCellCandidateDto cell) =>
        $"{cell.DoorCode} - {cell.AreaDescription}, column {cell.Column}, floor {cell.Floor}"
        + (cell.Description is { Length: > 0 } description ? $", {description}" : "")
        + (cell.LoadUnitsInCell == 1 ? ", 1 load unit in it" : $", {cell.LoadUnitsInCell} load units in it");

    /// <summary>One choice on the gateway: a radio button with its label.</summary>
    private RenderFragment GatewayOption(string value, string label, GatewayChoice choice) =>
        @<label class="drawio-mission-destination-option">
            <input type="radio" id="@($"drawio-mission-destination-gateway-{value}")" name="drawio-mission-destination-gateway"
                   value="@value" checked="@(_gatewayChoice == choice)" @onchange="() => _gatewayChoice = choice" />
            @label
        </label>;

    private void GatewayPicked(ChangeEventArgs e) =>
        _gateway = Guid.TryParse(e.Value as string, out var id) ? id : null;

    /// <summary>The second step: the change sent with the choice on the gateway as the operator left it.</summary>
    private Task ConfirmDestinationAsync()
    {
        if (_pendingDestination is not { } asked || _sending is not null) return Task.CompletedTask;
        if (!CanConfirmDestination(asked)) return Task.CompletedTask;
        var request = _gatewayChoice switch
        {
            GatewayChoice.Clear => new DestinationRequest(asked, MissionGatewayUpdate.Clear, null),
            GatewayChoice.Change when _gateway is { } through => new DestinationRequest(asked, MissionGatewayUpdate.Set(through), DeviceName(through)),
            GatewayChoice.Change => null,
            _ => new DestinationRequest(asked, MissionGatewayUpdate.Keep, null),
        };
        if (request is null) return Task.CompletedTask;
        // Item 54: a precise cell goes alone - through a relocator it is the relocator that deposits it
        // (the host refuses the two together); otherwise what the relocator does, when it is one.
        request = PreciseCell(asked) is { } cell
            ? request with { CellCode = cell }
            : request with { Arrival = asked.TargetIsRelocator ? _arrival : null };

        _pendingDestination = null;
        return SendDestinationAsync(request);
    }

    /// <summary>The offer after a route the gateway blocked: the same change again, with the gateway cleared.</summary>
    private Task ClearTheGatewayAndSetAsync() =>
        _withoutTheGateway is { } blocked && _sending is null
            ? SendDestinationAsync(blocked with { Gateway = MissionGatewayUpdate.Clear, NewGatewayName = null })
            : Task.CompletedTask;

    /// <summary>
    /// The change asked of the host, and its answer told - see the file's own remarks. Never throws:
    /// it runs from a click.
    /// </summary>
    private async Task SendDestinationAsync(DestinationRequest request)
    {
        var asked = request.Asked;
        _sending = request.CellCode is { } asking
            ? $"Asking the host to send {asked.LoadUnit} into the cell {asking}..."
            : $"Asking the host to send {asked.LoadUnit} to {asked.Target}...";
        _outcome = null;
        _went = false;
        _withoutTheGateway = null;
        var readAgain = true;
        var took = false;
        try
        {
            var applied = await Session.Client.SetMissionDestinationAsync(asked.MissionId,
                new MissionDestinationUpdate(asked.TargetId, request.Gateway, request.Arrival, request.CellCode));
            _went = true;
            // Item 54, decision 4: with a step of the mission in flight the change waits for its end
            // (202), and the row read again shows it waiting; the gateway is said when it is applied.
            took = applied == MissionChangeApplied.Now;
            _outcome = took
                ? TookLine(request, null)
                : $"{asked.LoadUnitFirst} is moving: it is sent {(request.CellCode is { } into ? $"into the cell {into}" : $"to {asked.Target}")} at the end of the movement - the change is applied at the end of the movement.";
        }
        catch (WcsApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _outcome = DrawioSaid.Failed($"{asked.LoadUnitFirst} was NOT sent to {asked.Target}: it is no longer active on the host (it ended or was removed).", ex);
        }
        catch (WcsApiException ex) when (ex.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Conflict
                                             or HttpStatusCode.UnprocessableEntity or HttpStatusCode.ServiceUnavailable)
        {
            // A refusal: these four come BEFORE the arm below, which would call a 422 or a 503 "not known".
            // Most leave the row as it was. Two say what changed on the way, and the host says so in
            // the refusal: a lost storage cell, which the channel announces; and a change of cell
            // refused after the warehouse system was told that the load unit leaves its order, which
            // closes the mission (task 4 of voce 39) - the list is read again to drop its row. Until
            // the final review the host did not carry the closure, and the page guessed it from the
            // row being gone after a read that could be an older one.
            var refusal = Refusal.Of(ex.Body);
            readAgain = request.ChangeOfCell || refusal is { MissionClosed: true };
            var refused = $"{asked.LoadUnitFirst} was NOT sent to {asked.Target}: {Why(request, refusal, ex.Body)}.";
            _outcome = DrawioSaid.Failed(refusal is { MissionClosed: true }
                ? $"{refused} The mission was closed: the warehouse system had already been told that it leaves its order, so the load unit stays in its cell with no order."
                : $"{refused} {asked.Still}"
                  + (refusal is { LostTheCell: true }
                      ? $" Its cell was given back to the warehouse system on the way, so it has no cell now: the engine is reserving another one in {asked.Current ?? "its warehouse"}."
                      : ""), ex);
            // Offered only if the row and the target asked for are still the ones chosen: a row can be
            // chosen while the answer is on its way (towards a warehouse the engine asks the warehouse
            // system first), and the button would then send the change of a mission the page no longer
            // shows as chosen (fix round 2). The target cannot change meanwhile - its controls are
            // disabled while Asking - but the offer promises both.
            if (refusal is { Title: MissionDestinationProblems.NoRouteTitle, Gateway: not null, WouldRouteWithoutGateway: true, MissionClosed: false }
                && _chosen == asked.MissionId && _target == asked.TargetId)
                _withoutTheGateway = request;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // NOT known, as for a move (ConfirmMoveAsync): the request may have reached the host.
            var notKnown = DrawioSaid.Failed(
                $"It is NOT known whether {asked.LoadUnit} was sent to {asked.Target}, because {DrawioFailureWords.Why(ex)}. The list is read again from the host." + AskingAgain(asked), ex);
            _outcome = notKnown;
            _readBeforeAsking = new NotKnown(asked, notKnown);
        }
        finally
        {
            _sending = null;
        }

        if (readAgain && !_disposed) await ReadAsync();

        // The gateway is said from the row the host gives back, not from what was asked: the engine
        // drops a gateway the load unit has already reached (its position, or the position's group),
        // and the outcome must not promise a passage the route does not make. A read that failed says
        // nothing of it.
        if (took && !_disposed)
            _outcome = TookLine(request, _readError is null ? _board.Find(asked.MissionId) : null);
    }

    /// <summary>
    /// The outcome of a change the host took: where the load unit is bound, with the gateway from the
    /// row read again (<paramref name="row"/>, null: not read, and the gateway is not said). Item 54: a
    /// precise cell is said by its code, in the warehouse the row has (the engine writes the warehouse of
    /// the cell, also when a relocator or a group was chosen); what the relocator does is said after.
    /// </summary>
    private string TookLine(DestinationRequest request, MissionDto? row)
    {
        var asked = request.Asked;
        var bound = request.CellCode is { } code
            ? $"{asked.LoadUnitFirst} is now bound for the cell {code}"
              + (row?.DestinationItemId is { } storage && storage != Guid.Empty ? $" in {DeviceName(storage)}" : "")
            : $"{asked.LoadUnitFirst} is now bound for {asked.Target}";
        var arrival = request.Arrival switch
        {
            MissionRelocatorArrival.Stay => ", where it stays",
            MissionRelocatorArrival.Deposit => $", where it is deposited in a cell the warehouse system gives",
            _ => "",
        };
        return $"{bound}{GatewayClause(request, row)}{arrival}: the host took it.";
    }

    /// <summary>
    /// What the outcome says of the gateway, from the mission as the host has it after the change:
    /// the gateway it passes through (kept, or the one set), none when the operator cleared it, and
    /// none with the reason when the gateway asked for or kept is one the load unit has already
    /// reached.
    /// </summary>
    private string GatewayClause(DestinationRequest request, MissionDto? row)
    {
        if (row is null) return "";
        var now = row.GatewayItemId is { } through && through != Guid.Empty ? DeviceName(through) : null;
        return (request.Gateway.Mode, now) switch
        {
            (MissionGatewayUpdateMode.Keep, { } kept) => $", still passing through {kept}",
            (_, { } set) => $", passing through {set}",
            (MissionGatewayUpdateMode.Clear, null) => ", with no gateway",
            (MissionGatewayUpdateMode.Set, null) => $", with no gateway (it has already reached {request.NewGatewayName})",
            (MissionGatewayUpdateMode.Keep, null) when request.Asked.GatewayName is { } reached => $", with no gateway (it has already reached {reached})",
            _ => "",
        };
    }

    /// <summary>
    /// A change whose answer never came may have happened (the engine finishes it without anybody
    /// waiting): towards a warehouse, the same change again is a request for a cell there again -
    /// also after a change of the gateway alone, which then finds the gateway already written. The next
    /// request waits for the list read again (<see cref="_readBeforeAsking"/>).
    /// </summary>
    private static string AskingAgain(PendingDestination asked) => asked.TargetIsStorage
        ? " A new request waits for that read, which shows the gateway as it is now:"
          + $" if this change went through, the same request again asks the warehouse system for another cell in {asked.Target}."
        : "";

    /// <summary>
    /// Why the host refused, in plain words, from the problem's title and fields; for a refusal this
    /// page does not know, that the host refused it - its own words are behind the line's "?" with the
    /// rest of its answer (row 37 of the queue, extended to the whole page on 10/10), where they used to
    /// be quoted in the sentence.
    /// </summary>
    private string Why(DestinationRequest request, Refusal? refusal, string body)
    {
        var asked = request.Asked;
        const string hostWords = "the host refused it";
        if (refusal is null) return hostWords;
        // Which of the host's two 503s it is, from the field the host writes for it (row 34 of the
        // queue), not from the title: the warehouse system that does not answer, or the engine not loaded.
        switch (DrawioSelectionCoordinator.UnavailableReason(body))
        {
            case ServiceUnavailableProblems.WarehouseUnreachable: return "the warehouse system does not answer";
            case ServiceUnavailableProblems.EngineNotLoaded: return "the engine is not ready (it is not loaded on the host)";
        }
        return refusal.Title switch
        {
            // Since item 54 a step in flight makes the change wait (202): what is left of this 409 is the
            // mission moved while the change was being made.
            MissionDestinationProblems.StepInFlightTitle => "it moved while the change was being made - try again when its step ends",
            // Not this mission: another one of its group that copied its door (the same cell) cannot be
            // stopped right now, and the change touched nothing (owner's answer 4 of 9/10).
            MissionDestinationProblems.CopyInFlightTitle => "another load unit sharing its cell is moving: try again in a moment",
            MissionDestinationProblems.CellSearchInFlightTitle =>
                "a search for its storage cell, or another change of its destination, is under way - try again when it ends",
            MissionDestinationProblems.AlreadyThereTitle => "it is already there",
            MissionDestinationProblems.DeviceNotFoundTitle => $"the host does not know {asked.Target} as a device",
            MissionDestinationProblems.GatewayNotFoundTitle => $"the host does not know {request.NewGatewayName} as a device to pass through",
            MissionDestinationProblems.NoRouteTitle => refusal.Gateway is { } gateway
                ? $"there is no route from {asked.Position} to {asked.Target} passing through {DeviceName(gateway)}"
                  + (refusal.WouldRouteWithoutGateway ? "; without the gateway there is one" : ", nor without it")
                : $"there is no route from {asked.Position} to {asked.Target}",
            MissionDestinationProblems.NoStorageCellTitle => refusal.NoOtherFreeCell
                ? $"there is no other free cell in {asked.Target} - the cell it has stays reserved for it"
                : $"the warehouse system has no cell to give it in {asked.Target} (the engine's log says why)",
            // A no from the warehouse system, not a silence: it got the first report of the change of cell and
            // did not apply it, so the extraction stays as it was (owner's answer 4 of 8/10, evening).
            MissionDestinationProblems.WarehouseRefusedTitle => "the warehouse system refused the change",
            // Item 54, decision 5: the page asks it only of a relocator, so the plant changed meanwhile.
            MissionDestinationProblems.NotARelocatorTitle =>
                $"{asked.Target} is not the relocator of any warehouse, so it cannot be told to deposit it or to keep it",
            MissionDestinationProblems.InvalidDestinationChoiceTitle => "the choice sent with it is not valid",
            // Item 54, decision 6: the precise cell, refused by the WCS or by the warehouse system, from the field.
            MissionDestinationProblems.CellRefusedTitle => refusal.CellRefusal switch
            {
                "unknownDoor" => $"no cell has the door code {request.CellCode}",
                "notADoorA" => $"{request.CellCode} is the code of a door B: a cell is chosen by its door A code",
                "cellNotAvailable" => $"the warehouse system says the cell {request.CellCode} is not free, or does not suit the load unit",
                "unknownLoadUnit" => "the warehouse system does not know its load unit",
                "notInTheChoice" => asked.TargetIsRelocator
                    ? $"the cell {request.CellCode} is not one {asked.Target} serves"
                    : $"the cell {request.CellCode} is not in {asked.Target}",
                _ => $"the cell {request.CellCode} was refused",
            },
            _ => hostWords,
        };
    }

    /// <summary>A refusal of the destination's route as the page reads it: the title, and the fields some titles carry.</summary>
    private sealed record Refusal(string? Title, Guid? Gateway, bool WouldRouteWithoutGateway, bool NoOtherFreeCell, bool LostTheCell,
        bool MissionClosed, string? CellRefusal = null)
    {
        /// <summary>The problem document of a refusal; null for a body that is not one.</summary>
        public static Refusal? Of(string body)
        {
            if (string.IsNullOrWhiteSpace(body)) return null;
            try
            {
                using var problem = JsonDocument.Parse(body);
                var root = problem.RootElement;
                if (root.ValueKind != JsonValueKind.Object) return null;
                return new Refusal(
                    root.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String ? title.GetString() : null,
                    root.TryGetProperty(MissionDestinationProblems.GatewayExtension, out var gateway)
                        && gateway.ValueKind == JsonValueKind.String && gateway.TryGetGuid(out var id) ? id : null,
                    root.TryGetProperty(MissionDestinationProblems.WouldRouteWithoutGatewayExtension, out var without)
                        && without.ValueKind == JsonValueKind.True,
                    root.TryGetProperty(MissionDestinationProblems.NoOtherFreeCellExtension, out var other)
                        && other.ValueKind == JsonValueKind.True,
                    root.TryGetProperty(MissionDestinationProblems.LostTheCellExtension, out var lost)
                        && lost.ValueKind == JsonValueKind.True,
                    root.TryGetProperty(MissionDestinationProblems.MissionClosedExtension, out var closed)
                        && closed.ValueKind == JsonValueKind.True,
                    root.TryGetProperty(MissionDestinationProblems.CellRefusalExtension, out var cell)
                        && cell.ValueKind == JsonValueKind.String ? cell.GetString() : null);
            }
            catch (JsonException)
            {
                return null;
            }
        }
    }

    // ---- The live channel -------------------------------------------------------------------------

    /// <summary>A mission changed. On the channel's thread: only InvokeAsync from here, and nothing thrown back.</summary>
    private void OnMissionChanged(MissionDto mission, MissionChange change) => OnTheRenderer(() =>
    {
        if (!Open)
        {
            _stale = true;
            return;
        }

        if (_board.Apply(mission, change))
        {
            NormalizePage();
            StateHasChanged();
        }
    });

    /// <summary>Events may have gone by unseen (the channel came back, or the host signalled a gap): read again - now if open, at the opening if shut.</summary>
    private void OnResynced() => OnTheRenderer(() =>
    {
        if (!Open)
        {
            _stale = true;
            return;
        }

        _ = ReadAsync();
    });

    private void OnTheRenderer(Action work)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed) work();
            });
        }
        catch (ObjectDisposedException)
        {
            // The renderer is gone: there is no list left to update.
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_subscribedFeed is not null)
        {
            _subscribedFeed.MissionChanged -= OnMissionChanged;
            _subscribedFeed.Resynced -= OnResynced;
        }
    }
}
