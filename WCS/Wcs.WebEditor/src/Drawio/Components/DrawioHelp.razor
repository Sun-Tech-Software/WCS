@* The "?" of the draw.io page (passata grafica, 2026-09-29): the long explanation of a window or a
   panel, behind an icon instead of on screen. Shut, the text is HIDDEN, not removed: it stays in the
   page, word for word, inside the element that carries its id today, and whoever reads it by id (a
   test) still finds it. A screen reader does not while it is shut - hidden takes it out of the
   accessibility tree - and reads it once the "?" (aria-expanded, aria-controls) has opened it.

   The "?" opens and shuts it, and Esc shuts it - both here. A click anywhere else shuts it too, and
   that part is drawio-help.js's: a press inside draw.io's frame never reaches the page, a press that
   is cancelled (draw.io's shapes panel, a window's title bar) moves no focus, and Blazor's focusout
   carries no relatedTarget, so only the browser can tell focus moving from the "?" into the note
   from focus leaving both. Where the note opens is the module's too: fixed to the viewport, inside
   the browser's window wherever the "?" is (wcs-webeditor.css, .drawio-help-body). The module is
   fetched at the first opening, not at the first render: the page carries a "?" in every window and
   most are never opened. That first opening waits for it, so that no opening of the note is painted
   before the module has placed it. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="drawio-help-wrap" @ref="_element" @onkeydown="OnKeyDown">
    <button type="button" id="@Id" class="drawio-btn-icon drawio-help" aria-label="@Label"
            aria-expanded="@(_open ? "true" : "false")" aria-controls="@($"{Id}-body")"
            @onclick="ToggleAsync"><DrawioIcon Name="help" /></button>
    @* tabindex -1: a press on the text puts the focus in the note, which the module then reads as
       focus staying inside - without it the focus would go to whatever focusable box holds the "?"
       (a window) and the note would shut under the hand that is selecting its words. *@
    <div id="@($"{Id}-body")" class="drawio-popover drawio-help-body" role="note" tabindex="-1"
         hidden="@(!_open)">@ChildContent</div>
</div>

@code {
    public const string ModulePath = "./_content/Wcs.WebEditor/drawio-help.js";

    /// <summary>The id of the "?"; the note is <c>{Id}-body</c>.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>What the "?" is called for a screen reader - "About Devices".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DrawioHelp>? _self;
    private Task? _watch;
    private bool _disposed;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    /// <summary>
    /// The module's word that a press landed outside the note or the focus left it - often both, for
    /// one click. It only ever shuts: it may arrive after the "?" has already shut the note, or after
    /// its own first word, and a toggle would then open it again under a click elsewhere.
    /// </summary>
    [JSInvokable]
    public void Shut()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
    }

    /// <summary>
    /// The "?" pressed. The first opening waits for the module to watch the note: the module places
    /// the note inside the browser's window as the browser un-hides it, before it is painted. Un-hidden
    /// first and watched after, the note was painted where the stylesheet hangs it - its start past the
    /// browser's left edge, from a window dragged there - until the module's round trips (the fetch,
    /// then the watch) came back. Without the module it opens all the same, where the stylesheet puts it.
    /// </summary>
    private async Task ToggleAsync()
    {
        if (!_open) await (_watch ??= WatchAsync());
        _open = !_open;
    }

    private async Task WatchAsync()
    {
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference?>("import", ModulePath);
            // Gone while the module was on its way: DisposeAsync has already run and found nothing to
            // let go of, so the module is let go here, and nothing is watched or handed a reference
            // to a component that is no more. The "?" beside the sentence of the cells that could not
            // be read (row 29 of the queue) goes with every change of selection and every reread.
            if (_disposed)
            {
                if (module is not null) await module.DisposeAsync();
                return;
            }
            _module = module;
            _self = DotNetObjectReference.Create(this);
            if (_module is not null) await _module.InvokeVoidAsync("watchHelp", _element, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Without the module the "?" and Esc still open and shut the note: only a click elsewhere
            // leaves it open.
            _module = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unwatchHelp", _element);
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Disposal must not throw: at worst the listeners stay on an element that is gone.
        }
        finally
        {
            _self?.Dispose();
        }
    }
}
