<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The sample WMS runs in this process, on a free port. -->
    <ProjectReference Include="..\Wcs.SampleWms\Wcs.SampleWms.csproj" />
    <!-- The WCS's own clients: the sample is called through HttpWarehouse, the client the WCS uses,
         and the host through WcsClient. -->
    <ProjectReference Include="..\..\WCS\Wcs.Wms.Client\src\Wcs.Wms.Client.csproj" />
    <ProjectReference Include="..\..\WCS\Wcs.Api.Client\src\Wcs.Api.Client.csproj" />
    <!-- The web editor's own rule for which WMS cells a device can be linked to (CellLinking). -->
    <ProjectReference Include="..\..\WCS\Wcs.WebEditor\src\Wcs.WebEditor.csproj" />
    <!-- The host is started as a PROCESS (WcsHostProcess), from its own build output: this reference
         only makes sure it is built, and up to date, before these tests run. Nothing of it is
         referenced or copied here. -->
    <ProjectReference Include="..\..\WCS\Wcs.Host\src\Wcs.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The plant and its loader, run by the end-to-end test exactly as the quick start runs them. -->
    <None Include="..\plant\sample-plant.json" Link="plant\sample-plant.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\plant\load-sample-plant.ps1" Link="plant\load-sample-plant.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
