{
  // Where the sample WMS listens. 5142 is the port the WCS host expects by default
  // (Wms:ApiAddress = http://localhost:5142 in the host's appsettings.json). Override it with
  // --urls http://localhost:6000 on the command line or with the environment variable URLS.
  "Urls": "http://localhost:5142",

  "SampleWms": {
    // The key the WCS must send in the X-Api-Key header. The WCS host sends the value of its own
    // Wms:ApiKey setting: the two must be equal. This default is public (it is in a sample on
    // GitHub): change it before the sample listens on anything but localhost.
    "ApiKey": "sample-wms-key",

    // How long a storage reservation lives without the WCS asking for it again
    // (GET reservations/{missionId} renews it). A reservation older than this is an orphan - the
    // mission that held it is gone - and the cell becomes free again.
    "ReservationLifetimeMinutes": 10
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
